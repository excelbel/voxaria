
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>VOXARIA Admin Dashboard</title>
  <link href="https://cdnjs.cloudflare.com/ajax/libs/quill/1.3.7/quill.snow.min.css" rel="stylesheet">
  <style>
    *{box-sizing:border-box;}
    body{font-family:Arial,sans-serif;background:#f4f6f9;margin:0;padding:20px;}
    .container{max-width:1200px;margin:auto;}
    .header{display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;margin-bottom:20px;gap:10px;}
    .header h1{margin:0;font-size:1.5rem;color:#111;}
    .header-actions{display:flex;gap:8px;flex-wrap:wrap;}
    .btn{display:inline-block;text-decoration:none;padding:9px 16px;border-radius:6px;font-size:13px;font-weight:700;border:none;cursor:pointer;color:#fff !important;}
    .btn-red{background:#dc3545;}.btn-red:hover{background:#b02a37;}
    .btn-green{background:#28a745;}.btn-green:hover{background:#1e7e34;}
    .btn-blue{background:#007bff;}.btn-blue:hover{background:#0056b3;}
    .btn-purple{background:#6f42c1;}.btn-purple:hover{background:#5a32a3;}
    .btn-dark{background:#0f2027;color:#ffd700 !important;font-weight:700;}
    .badge-new{background:#dc3545;color:#fff;padding:2px 7px;border-radius:20px;font-size:11px;margin-left:4px;}
    .card{background:#fff;padding:20px;border-radius:8px;margin-bottom:25px;box-shadow:0 2px 10px rgba(0,0,0,.08);}
    .stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:15px;margin-bottom:20px;}
    .stat-box{background:#fff;padding:18px;border-radius:8px;box-shadow:0 2px 10px rgba(0,0,0,.08);text-align:center;}
    .stat-box h2{margin:0 0 4px;font-size:26px;color:#007bff;}
    .stat-box p{margin:0;color:#666;font-size:13px;}
    input,select{width:100%;padding:11px;margin-bottom:12px;border:1px solid #ddd;border-radius:6px;box-sizing:border-box;font-size:14px;}
    .quill-wrapper{margin-bottom:12px;}
    .quill-editor{height:280px;background:#fff;}
    .ql-toolbar{border-radius:6px 6px 0 0;border:1px solid #ddd !important;}
    .ql-container{border:1px solid #ddd !important;border-top:none !important;border-radius:0 0 6px 6px;font-size:15px;}
    .upload-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:12px;}
    .upload-group label.group-label{display:block;font-size:13px;font-weight:700;color:#444;margin-bottom:6px;}
    .upload-box{position:relative;border:2px dashed #ccc;border-radius:6px;padding:18px 12px;text-align:center;cursor:pointer;background:#fafafa;transition:border-color .2s;margin-bottom:8px;}
    .upload-box:hover{border-color:#007bff;}
    .upload-box input[type="file"]{position:absolute;inset:0;opacity:0;cursor:pointer;width:100%;height:100%;margin:0;padding:0;}
    .upload-icon{font-size:24px;display:block;margin-bottom:4px;}
    .upload-text{font-size:13px;color:#555;}
    .upload-sub{font-size:11px;color:#999;margin-top:2px;}
    .file-name{font-size:12px;color:#007bff;margin-top:4px;min-height:16px;word-break:break-all;}
    .or-divider{display:flex;align-items:center;gap:8px;margin:6px 0 8px;}
    .or-divider span{font-size:12px;color:#999;white-space:nowrap;}
    .or-divider hr{flex:1;border:none;border-top:1px solid #e0e0e0;}
    .post-list{list-style:none;padding:0;}
    .post-item{display:flex;align-items:center;gap:12px;padding:12px 0;border-bottom:1px solid #eee;}
    .post-item img{width:80px;height:58px;object-fit:cover;border-radius:6px;flex-shrink:0;background:#e5e7eb;}
    .post-info{flex:1;min-width:0;}
    .post-title{font-weight:700;margin-bottom:4px;font-size:14px;line-height:1.4;}
    .post-category{font-size:12px;color:#666;}
    .badge{display:inline-block;padding:2px 7px;border-radius:20px;font-size:11px;color:#fff;}
    .badge-breaking{background:#dc3545;}
    .badge-draft{background:#ffc107;color:#333;}
    .badge-published{background:#28a745;}
    .post-actions{display:flex;align-items:center;gap:6px;flex-wrap:wrap;flex-shrink:0;}
    .post-actions a{text-decoration:none;font-weight:700;font-size:13px;}
    .edit-link{color:#007bff;}
    .delete-link{color:#dc3545;}
    .search-box{margin-bottom:16px;}
    .tab-bar{display:flex;gap:8px;margin-bottom:16px;flex-wrap:wrap;}
    .tab-bar button{padding:7px 16px;border-radius:5px;border:1px solid #ddd;background:#f4f6f9;color:#333;cursor:pointer;font-size:13px;font-weight:600;}
    .tab-bar button.active{background:#007bff;color:#fff;border-color:#007bff;}
    @media(max-width:700px){
      .post-item{flex-direction:column;align-items:flex-start;}
      .upload-grid{grid-template-columns:1fr;}
    }
  </style>
</head>
<body>
<div class="container">

  <div class="header">
    <h1>⚡ VOXARIA Admin</h1>
    <div class="header-actions">
      <a href="/admin/messages" class="btn btn-dark">
        📩 Messages
        <% if(unreadMessages > 0){ %><span class="badge-new"><%= unreadMessages %></span><% } %>
      </a>
      <a href="/admin/subscribers" class="btn btn-green">📬 Subscribers (<%= subscriberCount || 0 %>)</a>
      <a href="/logout" class="btn btn-red">Logout</a>
    </div>
  </div>

  <!-- STATS -->
  <div class="stats">
    <div class="stat-box">
      <h2><%= posts ? posts.length : 0 %></h2>
      <p>Total Posts</p>
    </div>
    <div class="stat-box">
      <h2 style="color:#28a745;"><%= posts ? posts.filter(p => p.published).length : 0 %></h2>
      <p>Published</p>
    </div>
    <div class="stat-box">
      <h2 style="color:#ffc107;"><%= posts ? posts.filter(p => !p.published).length : 0 %></h2>
      <p>Drafts</p>
    </div>
    <div class="stat-box">
      <h2 style="color:#dc3545;"><%= posts ? posts.filter(p => p.isBreaking).length : 0 %></h2>
      <p>Breaking</p>
    </div>
    <div class="stat-box">
      <h2 style="color:#6f42c1;"><%= subscriberCount || 0 %></h2>
      <p>Subscribers</p>
    </div>
  </div>

  <!-- CREATE FORM -->
  <div class="card">
    <h2 style="margin:0 0 16px;">✍️ Create New Story</h2>
    <form id="createForm" action="/admin/create" method="POST" enctype="multipart/form-data">

      <input type="text" name="title" placeholder="Story Title *" required>
      <input type="text" name="author" value="Admin" placeholder="Author">

      <select name="category">
        <optgroup label="── News ──">
          <option value="News">📰 Latest News</option>
          <option value="Politics">🏛️ Politics</option>
          <option value="Security">🛡️ Security</option>
          <option value="International">🌍 International</option>
          <option value="Article">✍️ Article</option>
        </optgroup>
        <optgroup label="── Sports ──">
          <option value="Sports">⚽ Sports</option>
          <option value="Football">🥅 Football</option>
          <option value="Basketball">🏀 Basketball</option>
          <option value="Athletics">🏃 Athletics</option>
        </optgroup>
        <optgroup label="── Entertainment ──">
          <option value="Entertainment">🎬 Entertainment</option>
          <option value="Lifestyle">💃 Lifestyle</option>
          <option value="Music">🎵 Music</option>
          <option value="Movies">🎥 Movies</option>
        </optgroup>
        <optgroup label="── Technology ──">
          <option value="Technology">💻 Technology</option>
          <option value="Science">🔬 Science</option>
          <option value="AI">🤖 AI & Innovation</option>
        </optgroup>
        <optgroup label="── Business ──">
          <option value="Finance">💰 Finance</option>
          <option value="Economy">📈 Economy</option>
          <option value="Markets">📊 Markets</option>
        </optgroup>
        <optgroup label="── Health ──">
          <option value="Health">❤️ Health Tips</option>
          <option value="Wellness">🧘 Wellness</option>
          <option value="Journals">📖 Journals</option>
        </optgroup>
      </select>

      <div class="upload-grid">
        <div class="upload-group">
          <label class="group-label">Thumbnail</label>
          <div class="upload-box">
            <input type="file" name="thumbnailFile" accept="image/*" onchange="showFileName(this,'thumbName')">
            <span class="upload-icon">🖼️</span>
            <div class="upload-text">Click to upload</div>
            <div class="upload-sub">PNG, JPG, WEBP</div>
          </div>
          <div class="file-name" id="thumbName"></div>
          <div class="or-divider"><hr><span>or paste URL</span><hr></div>
          <input type="text" name="thumbnail" placeholder="Thumbnail URL">
        </div>
        <div class="upload-group">
          <label class="group-label">Main Image / Video</label>
          <div class="upload-box">
            <input type="file" name="mainImageFile" accept="image/*,video/*" onchange="showFileName(this,'mainName')">
            <span class="upload-icon">📷</span>
            <div class="upload-text">Click to upload</div>
            <div class="upload-sub">PNG, JPG, MP4, MOV</div>
          </div>
          <div class="file-name" id="mainName"></div>
          <div class="or-divider"><hr><span>or paste URL</span><hr></div>
          <input type="text" name="mainImage" placeholder="Main Image URL">
        </div>
      </div>

      <label class="group-label" style="display:block;margin-bottom:6px;">Story Content</label>
      <div class="quill-wrapper">
        <div id="createEditor" class="quill-editor"></div>
      </div>
      <textarea name="content" id="createContent" style="display:none;"></textarea>

      <label style="display:flex;align-items:center;gap:8px;margin-bottom:16px;">
        <input type="checkbox" name="isBreaking" style="width:auto;margin:0;">
        <span style="font-size:14px;">🔴 Mark as Breaking News</span>
      </label>

      <button type="submit" class="btn btn-blue" style="width:100%;padding:13px;font-size:15px;">
        💾 Save as Draft
      </button>
    </form>
  </div>

  <!-- POST LIST -->
  <div class="card">
    <h2 style="margin:0 0 16px;">📋 All Stories</h2>

    <input type="text" id="searchInput" class="search-box" placeholder="🔍 Search stories...">

    <div class="tab-bar">
      <button class="active" onclick="filterPosts('all',this)">All</button>
      <button onclick="filterPosts('draft',this)">Drafts</button>
      <button onclick="filterPosts('published',this)">Published</button>
    </div>

    <ul class="post-list" id="postList">
      <% if(posts && posts.length > 0){ %>
        <% posts.forEach(post => { %>
          <li class="post-item" data-status="<%= post.published ? 'published' : 'draft' %>">

            <img
              src="<%= post.thumbnail || '/voxaria-logo.png' %>"
              onerror="this.onerror=null;this.src='/voxaria-logo.png'">

            <div class="post-info">
              <div class="post-title">
                <%= post.title %>
                <% if(post.isBreaking){ %><span class="badge badge-breaking">Breaking</span><% } %>
                <% if(post.published){ %>
                  <span class="badge badge-published">Live</span>
                <% } else { %>
                  <span class="badge badge-draft">Draft</span>
                <% } %>
              </div>
              <div class="post-category"><%= post.category || 'News' %></div>
            </div>

            <div class="post-actions">
              <a class="edit-link" href="/admin/edit/<%= post._id %>">Edit</a>

              <% if(post.published){ %>
                <form action="/admin/unpublish/<%= post._id %>" method="POST" style="display:inline">
                  <button class="btn" style="background:#ffc107;color:#333;padding:5px 11px;font-size:12px;" type="submit">Unpublish</button>
                </form>
              <% } else { %>
                <form action="/admin/publish/<%= post._id %>" method="POST" style="display:inline">
                  <button class="btn btn-green" style="padding:5px 11px;font-size:12px;" type="submit">Publish</button>
                </form>
              <% } %>

              <% if(post.published){ %>
                <form action="/admin/newsletter/<%= post._id %>" method="POST" style="display:inline"
                  onsubmit="return confirm('Send to <%= subscriberCount || 0 %> subscribers?')">
                  <button class="btn btn-purple" style="padding:5px 11px;font-size:12px;" type="submit">📧</button>
                </form>
              <% } %>

              <a class="delete-link" href="/admin/delete/<%= post._id %>"
                onclick="return confirm('Delete this story?')">Delete</a>
            </div>

          </li>
        <% }) %>
      <% } else { %>
        <p style="color:#666;text-align:center;padding:30px;">No stories yet. Create your first one above!</p>
      <% } %>
    </ul>
  </div>

</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/quill/1.3.7/quill.min.js"></script>
<script>
const createQuill = new Quill('#createEditor', {
  theme: 'snow',
  placeholder: 'Write your story here...',
  modules: {
    toolbar: [
      [{ font: [] }, { size: ['small', false, 'large', 'huge'] }],
      ['bold', 'italic', 'underline', 'strike'],
      [{ color: [] }, { background: [] }],
      [{ align: [] }],
      [{ header: [1,2,3,4,5,6,false] }],
      [{ list: 'ordered' }, { list: 'bullet' }],
      [{ indent: '-1' }, { indent: '+1' }],
      ['blockquote', 'code-block'],
      ['link', 'image'],
      ['clean']
    ]
  }
});

document.getElementById('createForm').addEventListener('submit', function() {
  document.getElementById('createContent').value = createQuill.root.innerHTML;
});

document.getElementById("searchInput").addEventListener("keyup", function() {
  const filter = this.value.toLowerCase();
  document.querySelectorAll(".post-item").forEach(item => {
    item.style.display = item.innerText.toLowerCase().includes(filter) ? "flex" : "none";
  });
});

function filterPosts(status, btn) {
  document.querySelectorAll(".tab-bar button").forEach(b => b.classList.remove("active"));
  btn.classList.add("active");
  document.querySelectorAll(".post-item").forEach(item => {
    item.style.display = (status === "all" || item.dataset.status === status) ? "flex" : "none";
  });
}

function showFileName(input, targetId) {
  const el = document.getElementById(targetId);
  el.textContent = input.files && input.files[0] ? input.files[0].name : '';
}
</script>
</body>
</html>
