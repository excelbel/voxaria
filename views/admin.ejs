<!-- POSTS LIST -->
<ul class="post-list">

  <% if (Array.isArray(posts) && posts.length > 0) { %>

    <% posts.forEach(post => { %>
      <li class="post-item">

        <img
          src="<%= post.thumbnail || '/images/default-thumb.jpg' %>"
          alt="<%= post.title || 'Post image' %>"
        >

        <div class="post-info">
          <span class="post-title">
            <%= post.title || 'Untitled Post' %>
          </span>

          <small style="display:block; color:gray;">
            <%= post.category || 'Uncategorized' %> •
            <%= post.views || 0 %> views
          </small>
        </div>

        <div class="post-actions">
          <a href="/admin/edit/<%= post._id %>">Edit</a>

          <a
            href="/admin/delete/<%= post._id %>"
            onclick="return confirm('Are you sure you want to delete this post?')"
          >
            Delete
          </a>
        </div>

      </li>
    <% }) %>

  <% } else { %>

    <p style="padding:10px; color:gray;">
      No posts available yet. Create your first story.
    </p>

  <% } %>

</ul>