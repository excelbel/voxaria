<!DOCTYPE html>

<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>VOXARIA Admin Dashboard</title>

<style>
body{
  font-family:Arial,sans-serif;
  background:#f4f6f9;
  margin:0;
  padding:20px;
}

.container{
  max-width:1200px;
  margin:auto;
}

.header{
  display:flex;
  justify-content:space-between;
  align-items:center;
  flex-wrap:wrap;
  margin-bottom:20px;
}

.logout{
  text-decoration:none;
  background:#dc3545;
  color:#fff;
  padding:10px 15px;
  border-radius:5px;
}

.logout:hover{
  background:#b02a37;
}

.card{
  background:#fff;
  padding:20px;
  border-radius:8px;
  margin-bottom:25px;
  box-shadow:0 2px 10px rgba(0,0,0,.08);
}

.stats{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(200px,1fr));
  gap:15px;
  margin-bottom:20px;
}

.stat-box{
  background:#fff;
  padding:20px;
  border-radius:8px;
  box-shadow:0 2px 10px rgba(0,0,0,.08);
  text-align:center;
}

input,
textarea,
select{
  width:100%;
  padding:12px;
  margin-bottom:12px;
  border:1px solid #ddd;
  border-radius:6px;
  box-sizing:border-box;
}

textarea{
  min-height:220px;
  resize:vertical;
}

button{
  background:#007bff;
  color:#fff;
  border:none;
  padding:12px 20px;
  border-radius:6px;
  cursor:pointer;
}

button:hover{
  background:#0056b3;
}

.post-list{
  list-style:none;
  padding:0;
}

.post-item{
  display:flex;
  align-items:center;
  gap:15px;
  padding:15px 0;
  border-bottom:1px solid #eee;
}

.post-item img{
  width:90px;
  height:65px;
  object-fit:cover;
  border-radius:6px;
}

.post-info{
  flex:1;
}

.post-title{
  font-weight:bold;
  margin-bottom:5px;
}

.category{
  font-size:12px;
  color:#666;
}

.badge{
  display:inline-block;
  padding:3px 8px;
  background:#dc3545;
  color:#fff;
  border-radius:20px;
  font-size:11px;
}

.post-actions a{
  margin-left:10px;
  text-decoration:none;
  font-weight:bold;
}

.edit{
  color:#007bff;
}

.delete{
  color:#dc3545;
}

.search-box{
  margin-bottom:20px;
}

@media(max-width:700px){
  .post-item{
    flex-direction:column;
    align-items:flex-start;
  }
}
</style>

</head>

<body>

<div class="container">

<div class="header">
  <h1>VOXARIA Admin Dashboard</h1>
  <a href="/logout" class="logout">Logout</a>
</div>

<div class="stats">
  <div class="stat-box">
    <h2><%= posts ? posts.length : 0 %></h2>
    <p>Total Posts</p>
  </div>

  <div class="stat-box">
    <h2><%= posts ? posts.filter(p => p.isBreaking).length : 0 %></h2>
    <p>Breaking News</p>
  </div>

  <div class="stat-box">
    <h2><%= posts ? posts.filter(p => p.category === 'Politics').length : 0 %></h2>
    <p>Politics</p>
  </div>
</div>

<div class="card">

<h2>Create New Story</h2>

<form action="/admin/create" method="POST">

<input
type="text"
name="title"
placeholder="Story Title"
required>

<input
type="text"
name="author"
value="Admin"
placeholder="Author">

<select name="category">
<option value="News">News</option>
<option value="Article">Article</option>
<option value="Entertainment">Entertainment</option>
<option value="International">International</option>
<option value="Journals">Journals</option>
<option value="Politics">Politics</option>
<option value="Security">Security</option>
<option value="Sports">Sports</option>
</select>

<input
type="text"
name="thumbnail"
placeholder="Thumbnail URL">

<input
type="text"
name="mainImage"
placeholder="Main Image URL">

<textarea
name="content"
placeholder="Write story..."
required></textarea>

<label>
<input type="checkbox" name="isBreaking">
 Mark as Breaking News
</label>

<br><br>

<button type="submit">
Publish Story
</button>

</form>

</div>

<div class="card">

<h2>Published Stories</h2>

<input
type="text"
id="searchInput"
class="search-box"
placeholder="Search stories...">

<ul class="post-list" id="postList">

<% if(posts && posts.length > 0){ %>

<% posts.forEach(post => { %>

<li class="post-item">

<img
src="<%= post.thumbnail || '/images/default-thumb.jpg' %>"
onerror="this.src='/images/default-thumb.jpg'">

<div class="post-info">

<div class="post-title">
  <%= post.title %>

<% if(post.isBreaking){ %> <span class="badge">Breaking</span>
<% } %>

</div>

<div class="category">
  <%= post.category || 'News' %>
</div>

</div>

<div class="post-actions">

<a
class="edit"
href="/admin/edit/<%= post._id %>">
Edit </a>

<a
class="delete"
href="/admin/delete/<%= post._id %>"
onclick="return confirm('Delete this story?')">
Delete </a>

</div>

</li>

<% }) %>

<% } else { %>

<p>No stories available.</p>

<% } %>

</ul>

</div>

</div>

<script>
const searchInput = document.getElementById("searchInput");

searchInput.addEventListener("keyup", function(){
  const filter = this.value.toLowerCase();

  document.querySelectorAll(".post-item")
    .forEach(item => {

      const title = item.innerText.toLowerCase();

      item.style.display =
        title.includes(filter)
        ? "flex"
        : "none";
    });
});
</script>

</body>
</html>
