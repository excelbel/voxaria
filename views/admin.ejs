<!DOCTYPE html>

<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>VOXARIA Admin Dashboard</title>

<style>
body{
font-family:Arial,sans-serif;
background:#f4f6f9;
margin:0;
padding:20px;
}

.container{
max-width:1200px;
margin:auto;
}

h1{
margin-bottom:20px;
}

.card{
background:#fff;
padding:20px;
border-radius:8px;
margin-bottom:25px;
box-shadow:0 2px 10px rgba(0,0,0,.08);
}

input,
textarea,
select{
width:100%;
padding:12px;
margin-bottom:12px;
border:1px solid #ddd;
border-radius:6px;
box-sizing:border-box;
}

textarea{
min-height:220px;
resize:vertical;
}

button{
background:#007bff;
color:#fff;
border:none;
padding:12px 20px;
border-radius:6px;
cursor:pointer;
}

button:hover{
background:#0056b3;
}

.stats{
display:grid;
grid-template-columns:repeat(auto-fit,minmax(200px,1fr));
gap:15px;
margin-bottom:20px;
}

.stat-box{
background:#fff;
padding:20px;
border-radius:8px;
box-shadow:0 2px 10px rgba(0,0,0,.08);
text-align:center;
}

.post-list{
list-style:none;
padding:0;
margin:0;
}

.post-item{
display:flex;
align-items:center;
justify-content:space-between;
padding:15px;
border-bottom:1px solid #eee;
gap:15px;
}

.post-item img{
width:80px;
height:60px;
object-fit:cover;
border-radius:5px;
}

.post-title{
flex:1;
font-weight:600;
}

.post-actions a{
margin-left:10px;
text-decoration:none;
font-weight:bold;
}

.post-actions a:first-child{
color:#007bff;
}

.post-actions a:last-child{
color:#dc3545;
}

.badge{
display:inline-block;
padding:4px 10px;
background:#dc3545;
color:#fff;
font-size:12px;
border-radius:20px;
margin-left:10px;
}

.logout{
float:right;
text-decoration:none;
background:#dc3545;
color:#fff;
padding:10px 15px;
border-radius:5px;
}

.logout:hover{
background:#b02a37;
}
</style>

</head>

<body>

<div class="container">

<a href="/logout" class="logout">Logout</a>

<h1>VOXARIA Admin Dashboard</h1>

<div class="stats">
<div class="stat-box">
<h2><%= posts ? posts.length : 0 %></h2>
<p>Total Posts</p>
</div>

<div class="stat-box">
<h2>
<%= posts ? posts.filter(p => p.isBreaking).length : 0 %>
</h2>
<p>Breaking News</p>
</div>
</div>

<div class="card">

<h2>Create New Story</h2>

<form action="/admin/create" method="POST">

<input
type="text"
name="title"
placeholder="Story Title"
required

>

<input
type="text"
name="author"
placeholder="Author"
value="Admin"

>

<select name="category">

<option value="News">News</option>

<option value="Article">Article</option>

<option value="Entertainment">Entertainment</option>

<option value="International">International</option>

<option value="Journals">Journals</option>

<option value="Politics">Politics</option>

<option value="Security">Security</option>

<option value="Sports">Sports</option>

</select>

<input
type="text"
name="thumbnail"
placeholder="Thumbnail Image URL"

>

<input
type="text"
name="mainImage"
placeholder="Main Image URL"

>

<textarea
name="content"
placeholder="Write your story here..."
required
></textarea>

<label>
<input type="checkbox" name="isBreaking">
 Mark as Breaking News
</label>

<br><br>

<button type="submit">
Publish Story
</button>

</form>

</div>

<div class="card">

<h2>Published Stories</h2>

<ul class="post-list">

<% if (Array.isArray(posts) && posts.length > 0) { %>

<% posts.forEach(post => { %>

<li class="post-item">

<img
src="<%= post.thumbnail || '/images/default-thumb.jpg' %>"
alt="<%= post.title %>"

>

<div class="post-title">

<%= post.title %>

<% if(post.isBreaking){ %> <span class="badge">Breaking</span>
<% } %>

</div>

<div class="post-actions">

<a href="/admin/edit/<%= post._id %>">
Edit
</a>

<a
href="/admin/delete/<%= post._id %>"
onclick="return confirm('Delete this story?')"

>

Delete </a>

</div>

</li>

<% }) %>

<% } else { %>

<p>No stories found.</p>

<% } %>

</ul>

</div>

</div>

</body>
</html>
