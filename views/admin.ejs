<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Admin Dashboard - VOXARIA</title>
  <link rel="stylesheet" href="/style.css">
  <style>
    body { font-family: Arial, sans-serif; background: #f4f4f4; color: #333; margin:0; padding:0; }
    header { background:#222; color:#fff; padding:15px 30px; }
    header h1 { margin:0; font-size:24px; display:inline-block; }
    header a { color:#fff; float:right; text-decoration:none; margin-top:4px; }
    main { max-width:1200px; margin:auto; padding:20px; display:flex; gap:40px; flex-wrap:wrap; }
    section { background:#fff; padding:20px; border-radius:5px; box-shadow:0 2px 6px rgba(0,0,0,0.1); flex:1; min-width:300px; }
    h2 { margin-top:0; margin-bottom:15px; font-size:20px; color:#222; }
    form input[type="text"], form textarea { width:100%; padding:10px; margin-bottom:10px; border:1px solid #ccc; border-radius:4px; }
    form textarea { resize:vertical; min-height:80px; }
    form button { background:#007bff; color:#fff; border:none; padding:10px 15px; border-radius:4px; cursor:pointer; }
    form button:hover { background:#0056b3; }
    .image-preview { margin:5px 0; max-width:200px; max-height:150px; border:1px solid #ccc; border-radius:4px; object-fit:cover; }
    .post-list { list-style:none; padding:0; margin:0; }
    .post-item { display:flex; align-items:center; justify-content:space-between; padding:10px 0; border-bottom:1px solid #eee; }
    .post-item img { width:80px; height:60px; object-fit:cover; margin-right:10px; border-radius:4px; }
    .post-actions a { margin-left:10px; text-decoration:none; color:#007bff; }
    .post-actions a:hover { text-decoration:underline; }
    .post-title { flex:1; margin-left:10px; font-weight:bold; color:#222; }
    @media(max-width:900px){
      main { flex-direction:column; gap:20px; }
    }
  </style>
</head>
<body>

<header>
  <h1>Admin Dashboard</h1>
  <a href="/logout">Logout</a>
</header>

<main>
  <!-- CREATE POST -->
  <section>
    <h2>Create New Post</h2>
    <form action="/admin/create" method="POST">
      <input type="text" name="title" placeholder="Title" required>
      <input type="text" name="author" placeholder="Author">
      <input type="text" name="category" placeholder="Category">
      <textarea name="content" placeholder="Write article..." required></textarea>

      <label>Thumbnail URL:</label>
      <input type="text" name="thumbnail" id="thumbnailInput" placeholder="Thumbnail URL">
      <img id="thumbnailPreview" class="image-preview" src="/images/default-thumb.jpg">

      <label>Main Image URL:</label>
      <input type="text" name="mainImage" id="mainImageInput" placeholder="Main Image URL">
      <img id="mainImagePreview" class="image-preview" src="/images/default-main.jpg">

      <label>
        <input type="checkbox" name="isBreaking"> Breaking News
      </label><br><br>

      <button type="submit">Publish Post</button>
    </form>
  </section>

  <!-- ALL POSTS -->
  <section>
    <h2>All Posts</h2>
    <ul class="post-list">
      <% posts.forEach(post => { %>
        <li class="post-item">
          <img src="<%= post.thumbnail %>" alt="Thumbnail">
          <span class="post-title"><%= post.title %></span>
          <div class="post-actions">
            <% if(role === 'admin'){ %>
              <a href="/admin/edit/<%= post._id %>">Edit</a>
              <a href="/admin/delete/<%= post._id %>">Delete</a>
            <% } else if(role === 'editor'){ %>
              <span style="font-size:0.9em; color:gray;">No edit/delete permission</span>
            <% } %>
          </div>
        </li>
      <% }) %>
    </ul>
  </section>
</main>

<script>
  const thumbnailInput = document.getElementById('thumbnailInput');
  const thumbnailPreview = document.getElementById('thumbnailPreview');
  thumbnailInput.addEventListener('input', () => {
    thumbnailPreview.src = thumbnailInput.value || '/images/default-thumb.jpg';
  });

  const mainImageInput = document.getElementById('mainImageInput');
  const mainImagePreview = document.getElementById('mainImagePreview');
  mainImageInput.addEventListener('input', () => {
    mainImagePreview.src = mainImageInput.value || '/images/default-main.jpg';
  });
</script>

</body>
</html>