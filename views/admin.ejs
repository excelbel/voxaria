<!-- POSTS LIST -->
<ul class="post-list">
  <% posts.forEach(post => { %>
    <li class="post-item">

      <img src="<%= post.thumbnail || '/images/default-thumb.jpg' %>">

      <span class="post-title"><%= post.title %></span>

      <div class="post-actions">
        <a href="/admin/edit/<%= post._id %>">Edit</a>
        <a href="/admin/delete/<%= post._id %>">Delete</a>
      </div>

    </li>
  <% }) %>
</ul>