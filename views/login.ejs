<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Admin Login - VOXARIA</title>
  <link rel="stylesheet" href="/style.css">

  <style>
    body {
      font-family: "Helvetica Neue", Arial, sans-serif;
      background: #f4f4f4;
      display: flex;
      justify-content: center;
      align-items: center;
      height: 100vh;
      margin: 0;
    }

    form {
      background: #fff;
      padding: 30px;
      border-radius: 8px;
      box-shadow: 0 4px 18px rgba(0,0,0,0.12);
      width: 340px;
      text-align: center;
    }

    h1 {
      margin-bottom: 18px;
      font-size: 22px;
      color: #222;
    }

    input[type="text"],
    input[type="password"] {
      width: 100%;
      padding: 12px;
      margin-bottom: 14px;
      border-radius: 6px;
      border: 1px solid #ccc;
      font-size: 14px;
      outline: none;
      transition: border 0.2s;
    }

    input:focus {
      border-color: #007bff;
    }

    button {
      background: #007bff;
      color: #fff;
      padding: 12px;
      border: none;
      border-radius: 6px;
      cursor: pointer;
      width: 100%;
      font-size: 15px;
      font-weight: 600;
      transition: 0.2s;
    }

    button:hover {
      background: #0056b3;
    }

    .note {
      font-size: 12px;
      margin-top: 12px;
      color: #777;
    }

    .error {
      color: red;
      font-size: 13px;
      margin-bottom: 10px;
    }
  </style>
</head>

<body>

  <form action="/login" method="POST" autocomplete="off">

    <h1>Admin Login</h1>

    <!-- ERROR MESSAGE (OPTIONAL FROM SERVER) -->
    <% if (typeof error !== "undefined" && error) { %>
      <div class="error"><%= error %></div>
    <% } %>

    <input type="text" name="username" placeholder="Username" required>

    <input type="password" name="password" placeholder="Password" required>

    <button type="submit">Login</button>

    <div class="note">
      Secure admin access only
    </div>

  </form>

</body>
</html>