<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Login - VOXARIA Admin</title>
  <link rel="stylesheet" href="/style.css">

  <style>
    body {
      font-family: "Helvetica Neue", Arial, sans-serif;
      background: #f4f4f4;
      display: flex;
      justify-content: center;
      align-items: center;
      height: 100vh;
      margin: 0;
    }

    form {
      background: #fff;
      padding: 30px;
      border-radius: 6px;
      box-shadow: 0 1px 10px rgba(0,0,0,0.08);
      width: 320px;
      text-align: center;
    }

    h1 {
      margin-bottom: 20px;
      font-size: 20px;
    }

    input[type="text"],
    input[type="password"] {
      width: 100%;
      padding: 10px;
      margin-bottom: 15px;
      border-radius: 4px;
      border: 1px solid #ccc;
      font-size: 14px;
      outline: none;
    }

    input:focus {
      border-color: #007bff;
    }

    button {
      background: #007bff;
      color: #fff;
      padding: 10px 16px;
      border: none;
      border-radius: 4px;
      cursor: pointer;
      width: 100%;
      font-size: 14px;
    }

    button:hover {
      background: #0056b3;
    }

    .note {
      font-size: 12px;
      margin-top: 10px;
      color: #777;
    }
  </style>
</head>

<body>

  <form action="/login" method="POST" autocomplete="off">
    <h1>Admin Login</h1>

    <input type="text" name="username" placeholder="Username" required>

    <input type="password" name="password" placeholder="Password" required>

    <button type="submit">Login</button>

    <div class="note">
      Secure admin access only
    </div>
  </form>

</body>
</html>