<section class="hero-featured">

  <div class="hero-grid">

    <% if (featuredPost) { %>
      <div class="hero-card">

        <img 
          src="<%= featuredPost.mainImage || '/images/default-main.jpg' %>" 
          alt="<%= featuredPost.title %>"
        >

        <div class="overlay">
          <h2>
            <a href="/news/<%= featuredPost.slug || featuredPost._id %>">
              <%= featuredPost.title %>
            </a>
          </h2>

          <p>
            <%= (featuredPost.content || '').substring(0, 120) %>...
          </p>

        </div>

      </div>
    <% } %>

    <% if (Array.isArray(featuredGrid) && featuredGrid.length > 0) { %>
      <% featuredGrid.forEach(post => { %>

        <div class="featured-card">

          <img 
            src="<%= post.thumbnail || '/images/default-thumb.jpg' %>" 
            alt="<%= post.title %>"
          >

          <div class="overlay">
            <h3>
              <a href="/news/<%= post.slug || post._id %>">
                <%= post.title %>
              </a>
            </h3>
          </div>

        </div>

      <% }) %>
    <% } %>

  </div>

</section>