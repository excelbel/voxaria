<header class="site-header">
  <div class="top-bar">

    <!-- LOGO -->
    <a href="/" class="logo-text">
      <img src="/voxaria-logo.png" alt="VOXARIA" style="height:45px;vertical-align:middle;margin-right:8px;"
        onerror="this.onerror=null;this.style.display='none'">
      VOXARIA
    </a>

    <!-- SEARCH -->
    <form action="/search" method="GET" class="search-form">
      <input type="text" name="q" placeholder="Search articles..." required>
      <button type="submit">🔍</button>
    </form>

    <!-- HAMBURGER -->
    <div class="hamburger-menu" onclick="toggleNav()" aria-label="Toggle menu">☰</div>

  </div>

  <!-- NAVIGATION -->
  <nav class="main-nav" id="mainNav">
    <ul>
      <li class="<%= currentPage === 'Home' ? 'active' : '' %>"><a href="/">Home</a></li>
      <li class="<%= currentPage === 'News' ? 'active' : '' %>"><a href="/category/News">News</a></li>
      <li class="<%= currentPage === 'Articles' ? 'active' : '' %>"><a href="/category/Article">Articles</a></li>
      <li class="<%= currentPage === 'Entertainment' ? 'active' : '' %>"><a href="/category/Entertainment">Entertainment</a></li>
      <li class="<%= currentPage === 'International' ? 'active' : '' %>"><a href="/category/International">International</a></li>
      <li class="<%= currentPage === 'Politics' ? 'active' : '' %>"><a href="/category/Politics">Politics</a></li>
      <li class="<%= currentPage === 'Security' ? 'active' : '' %>"><a href="/category/Security">Security</a></li>
      <li class="<%= currentPage === 'Sports' ? 'active' : '' %>"><a href="/category/Sports">Sports</a></li>
      <li class="<%= currentPage === 'Journals' ? 'active' : '' %>"><a href="/category/Journals">Journals</a></li>
      <li class="<%= currentPage === 'About' ? 'active' : '' %>"><a href="/about">About</a></li>
      <li class="<%= currentPage === 'Contact' ? 'active' : '' %>"><a href="/contact">Contact</a></li>
    </ul>
  </nav>
</header>

<style>
/* ── Header ── */
.site-header {
  background: linear-gradient(90deg, #0f2027, #203a43, #2c5364);
  color: #fff;
  position: sticky;
  top: 0;
  z-index: 1000;
  width: 100%;
  box-shadow: 0 4px 20px rgba(0,0,0,0.25);
}

.top-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12px 40px;
  gap: 16px;
  flex-wrap: nowrap;
}

.logo-text {
  font-size: 1.6rem;
  color: #ffd700;
  font-weight: bold;
  text-shadow: 1px 1px 4px rgba(0,0,0,0.5);
  white-space: nowrap;
  display: flex;
  align-items: center;
  text-decoration: none;
}

/* ── Search ── */
.search-form {
  display: flex;
  gap: 6px;
  flex: 1;
  max-width: 320px;
}

.search-form input {
  flex: 1;
  padding: 8px 14px;
  border: none;
  border-radius: 20px;
  font-size: 14px;
  outline: none;
  background: rgba(255,255,255,0.15);
  color: #fff;
  width: auto;
  margin-bottom: 0;
}

.search-form input::placeholder { color: rgba(255,255,255,0.6); }

.search-form input:focus {
  background: rgba(255,255,255,0.25);
}

.search-form button {
  background: #ffd700;
  color: #111;
  border: none;
  padding: 8px 14px;
  border-radius: 20px;
  cursor: pointer;
  font-size: 14px;
  font-weight: bold;
  box-shadow: none;
  transition: background 0.2s;
}

.search-form button:hover { background: #ffb347; }

/* ── Nav ── */
.main-nav {
  background: rgba(0,0,0,0.35);
  border-top: 1px solid rgba(255,255,255,0.08);
}

.main-nav ul {
  display: flex;
  gap: 0;
  list-style: none;
  padding: 0 30px;
  margin: 0;
  overflow-x: auto;
  scrollbar-width: none;
}

.main-nav ul::-webkit-scrollbar { display: none; }

.main-nav li {
  flex-shrink: 0;
}

.main-nav li a {
  display: block;
  padding: 12px 16px;
  color: rgba(255,255,255,0.85);
  font-size: 0.88rem;
  font-weight: 500;
  text-decoration: none;
  transition: color 0.2s, background 0.2s;
  white-space: nowrap;
  border-bottom: 3px solid transparent;
}

.main-nav li a:hover {
  color: #ffd700;
  border-bottom-color: #ffd700;
}

.main-nav li.active a {
  color: #ffd700;
  font-weight: bold;
  border-bottom-color: #ffd700;
}

/* ── Hamburger ── */
.hamburger-menu {
  display: none;
  cursor: pointer;
  font-size: 26px;
  color: #fff;
  padding: 4px 8px;
  border-radius: 4px;
  transition: background 0.2s;
  user-select: none;
}

.hamburger-menu:hover { background: rgba(255,255,255,0.1); }

/* ── Mobile ── */
@media (max-width: 768px) {
  .top-bar {
    padding: 12px 16px;
  }

  .hamburger-menu {
    display: block;
  }

  .search-form {
    max-width: 160px;
  }

  .main-nav {
    display: none;
  }

  .main-nav.open {
    display: block;
  }

  .main-nav ul {
    flex-direction: column;
    padding: 10px 0;
    overflow-x: unset;
  }

  .main-nav li a {
    padding: 12px 20px;
    border-bottom: 1px solid rgba(255,255,255,0.06);
    font-size: 0.95rem;
  }

  .main-nav li a:hover {
    background: rgba(255,255,255,0.08);
    border-bottom-color: transparent;
  }

  .main-nav li.active a {
    background: rgba(255,215,0,0.1);
    border-bottom-color: transparent;
  }
}
</style>

<script>
function toggleNav() {
  const nav = document.getElementById('mainNav');
  nav.classList.toggle('open');
}

// Close nav when a link is clicked on mobile
document.querySelectorAll('.main-nav a').forEach(link => {
  link.addEventListener('click', () => {
    if (window.innerWidth <= 768) {
      document.getElementById('mainNav').classList.remove('open');
    }
  });
});
</script>
