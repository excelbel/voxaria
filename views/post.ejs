<!DOCTYPE html>
<html lang="en">
<head>
  <title><%= post.title %> | Voxaria</title>

  <!-- SEO META (CLEAN + OPTIMIZED) -->
  <meta name="description" content="<%= ((post.aiSummary || post.content || '').replace(/<[^>]*>/g, '')).substring(0, 160) %>">

  <meta property="og:title" content="<%= post.title %>">
  <meta property="og:description" content="<%= ((post.aiSummary || post.content || '').replace(/<[^>]*>/g, '')).substring(0, 150) %>">
  <meta property="og:image" content="<%= post.mainImage || '/images/default-main.jpg' %>">
  <meta property="og:url" content="<%= baseUrl + '/post/' + post.slug %>">
  <meta property="og:type" content="article">

  <link rel="canonical" href="<%= baseUrl + '/post/' + post.slug %>">

  <link rel="stylesheet" href="/style.css">
</head>

<body>

<!-- HEADER -->
<header class="site-header">
  <div class="top-bar">
    <a href="/" class="logo-text">VOXARIA</a>

    <nav class="main-nav desktop-nav">
      <ul>
        <li><a href="/">Home</a></li>
        <li><a href="/category/News">News</a></li>
        <li><a href="/category/Articles">Articles</a></li>
        <li><a href="/category/Entertainment">Entertainment</a></li>
        <li><a href="/category/International">International</a></li>
        <li><a href="/category/Politics">Politics</a></li>
        <li><a href="/category/Sports">Sports</a></li>
      </ul>
    </nav>

    <div class="hamburger-menu" onclick="toggleMobileNav()">☰</div>
  </div>

  <nav class="main-nav mobile-nav" id="mobileNav">
    <ul>
      <li><a href="/">Home</a></li>
      <li><a href="/category/News">News</a></li>
      <li><a href="/category/Articles">Articles</a></li>
      <li><a href="/category/Entertainment">Entertainment</a></li>
      <li><a href="/category/International">International</a></li>
      <li><a href="/category/Politics">Politics</a></li>
      <li><a href="/category/Sports">Sports</a></li>
    </ul>
  </nav>
</header>

<script>
function toggleMobileNav() {
  const nav = document.getElementById("mobileNav");
  nav.style.display = nav.style.display === "block" ? "none" : "block";
}
</script>

<!-- ARTICLE -->
<main class="article-layout">

<article class="article">

  <h1 class="article-title"><%= post.title %></h1>

  <div class="article-meta">
    <span><strong>Date:</strong> <%= post.date ? post.date.toDateString() : "" %></span>
    <span><strong>Category:</strong> <%= post.category || "General" %></span>
    <span><strong>Views:</strong> <%= post.analytics?.views || 0 %></span>
    <span><strong>Likes:</strong> <%= post.analytics?.likes || 0 %></span>
  </div>

  <img
    src="<%= post.mainImage || '/images/default-main.jpg' %>"
    class="article-image"
    alt="<%= post.title %>"
  >

  <% if (post.aiSummary) { %>
    <div class="ai-summary">
      <h3>Quick Summary</h3>
      <p><%= post.aiSummary %></p>
    </div>
  <% } %>

  <div class="post-content">
    <%- post.content %>
  </div>

  <!-- SHARE -->
  <div class="share-buttons">

    <a target="_blank"
      href="https://wa.me/?text=<%= encodeURIComponent(post.title + ' ' + baseUrl + '/post/' + post.slug) %>">
      WhatsApp
    </a>

    <a target="_blank"
      href="https://www.facebook.com/sharer/sharer.php?u=<%= encodeURIComponent(baseUrl + '/post/' + post.slug) %>">
      Facebook
    </a>

    <button onclick="copyLink()">Copy Link</button>

  </div>

  <script>
    function copyLink() {
      const url = "<%= baseUrl + '/post/' + post.slug %>";
      navigator.clipboard.writeText(url);
      alert("Link copied!");
    }
  </script>

  <!-- LIKE -->
  <div class="post-actions">
    <form action="/like/<%= post._id %>" method="POST">
      <button type="submit">
        👍 Like (<%= post.analytics?.likes || 0 %>)
      </button>
    </form>
  </div>

</article>

<!-- RELATED POSTS -->
<% if (relatedPosts && relatedPosts.length > 0) { %>
<section class="related-posts">
  <h2>Related Articles</h2>

  <div class="related-grid">
    <% relatedPosts.forEach(rp => { %>
      <div class="related-card">
        <img src="<%= rp.thumbnail || '/images/default-thumb.jpg' %>" alt="<%= rp.title %>">
        <h3>
          <a href="/post/<%= rp.slug %>"><%= rp.title %></a>
        </h3>
      </div>
    <% }) %>
  </div>
</section>
<% } %>

<!-- COMMENTS -->
<section class="comments-section">

  <h2>Comments (<%= (post.comments || []).length %>)</h2>

  <% if (post.comments && post.comments.length > 0) { %>
    <% post.comments.forEach(comment => { %>
      <div class="comment">
        <strong><%= comment.name %></strong>
        <p><%= comment.text %></p>
      </div>
    <% }) %>
  <% } else { %>
    <p>No comments yet.</p>
  <% } %>

  <form action="/post/<%= post._id %>/comment" method="POST">
    <input name="name" placeholder="Your name" required>
    <textarea name="text" placeholder="Write a comment..." required></textarea>
    <button type="submit">Submit</button>
  </form>

</section>

</main>

</body>
</html>