<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title><%= post.title %> - VOXARIA</title>

  <!-- SEO / Social Preview -->
  <meta property="og:title" content="<%= post.title %>" />
  <meta property="og:description" content="<%= post.aiSummary || post.content.substring(0,150) %>" />
  <meta property="og:image" content="<%= post.mainImage || '/images/default-main.jpg' %>" />
  <meta property="og:url" content="https://voxaria.onrender.com/post/<%= post.slug %>" />
  <meta property="og:type" content="article" />

  <link rel="stylesheet" href="/style.css">
</head>

<body>

<!-- HEADER -->
<header class="site-header">
  <div class="top-bar">
    <a href="/" class="logo-text">VOXARIA</a>

    <nav class="main-nav desktop-nav">
      <ul>
        <li><a href="/">Home</a></li>
        <li><a href="/category/News">News</a></li>
        <li><a href="/category/Articles">Articles</a></li>
        <li><a href="/category/Entertainment">Entertainment</a></li>
        <li><a href="/category/International">International</a></li>
        <li><a href="/category/Politics">Politics</a></li>
        <li><a href="/category/Sports">Sports</a></li>
      </ul>
    </nav>

    <form class="search-form" action="/search" method="GET">
      <input type="text" name="q" placeholder="Search..." required>
      <button type="submit">🔍</button>
    </form>

    <div class="hamburger-menu" onclick="toggleMobileNav()">☰</div>
  </div>

  <nav class="main-nav mobile-nav" id="mobileNav">
    <ul>
      <li><a href="/">Home</a></li>
      <li><a href="/category/News">News</a></li>
      <li><a href="/category/Articles">Articles</a></li>
      <li><a href="/category/Entertainment">Entertainment</a></li>
      <li><a href="/category/International">International</a></li>
      <li><a href="/category/Politics">Politics</a></li>
      <li><a href="/category/Sports">Sports</a></li>
    </ul>
  </nav>
</header>

<script>
function toggleMobileNav() {
  const nav = document.getElementById("mobileNav");
  nav.style.display = nav.style.display === "block" ? "none" : "block";
}
</script>

<!-- ARTICLE -->
<main class="article-layout">

<article class="article">

  <h1 class="article-title"><%= post.title %></h1>

  <div class="article-meta">
    <span><strong>Author:</strong> <%= post.author %></span>
    <span><strong>Date:</strong> <%= post.date.toDateString() %></span>
    <span><strong>Category:</strong> <%= post.category %></span>
    <span><strong>Views:</strong> <%= post.analytics?.views || 0 %></span>
    <span><strong>Likes:</strong> <%= post.analytics?.likes || 0 %></span>
  </div>

  <% if(post.mainImage){ %>
    <img src="<%= post.mainImage %>" class="article-image">
  <% } else { %>
    <img src="/images/default-main.jpg" class="article-image">
  <% } %>

  <!-- ✅ AI SUMMARY -->
  <% if(post.aiSummary){ %>
    <div class="ai-summary">
      <h3>Quick Summary</h3>
      <p><%= post.aiSummary %></p>
    </div>
  <% } %>

  <div class="post-content">
    <%- post.content %>
  </div>

  <!-- SHARE BUTTONS -->
  <div class="share-buttons">

    <!-- WhatsApp -->
    <a target="_blank"
       href="https://wa.me/?text=<%= encodeURIComponent(post.title + ' https://voxaria.onrender.com/post/' + post.slug) %>">
      Share on WhatsApp
    </a>

    <!-- Facebook -->
    <a target="_blank"
       href="https://www.facebook.com/sharer/sharer.php?u=https://voxaria.onrender.com/post/<%= post.slug %>">
      Share on Facebook
    </a>

    <!-- Copy Link -->
    <button onclick="copyLink()">Copy Link</button>

  </div>

  <script>
    function copyLink() {
      navigator.clipboard.writeText("https://voxaria.onrender.com/post/<%= post.slug %>");
      alert("Link copied!");
    }
  </script>

  <!-- LIKE -->
  <div class="post-actions">
    <form action="/like/<%= post._id %>" method="POST">
      <button type="submit">
        👍 Like (<%= post.analytics?.likes || 0 %>)
      </button>
    </form>
  </div>

</article>

<!-- RELATED POSTS -->
<% if(relatedPosts && relatedPosts.length > 0){ %>
<section class="related-posts">
  <h2>Related Articles</h2>

  <div class="related-grid">
    <% relatedPosts.forEach(rp => { %>
      <div class="related-card">
        <img src="<%= rp.thumbnail || '/images/default-thumb.jpg' %>">
        <h3><a href="/post/<%= rp.slug %>"><%= rp.title %></a></h3>
      </div>
    <% }) %>
  </div>
</section>
<% } %>

<!-- COMMENTS -->
<section class="comments-section">

  <h2>Comments (<%= post.comments?.length || 0 %>)</h2>

  <% if(post.comments && post.comments.length){ %>
    <% post.comments.forEach(comment => { %>
      <div class="comment">
        <strong><%= comment.name %></strong>
        <p><%= comment.text %></p>
      </div>
    <% }) %>
  <% } else { %>
    <p>No comments yet.</p>
  <% } %>

  <form action="/post/<%= post._id %>/comment" method="POST">
    <input name="name" placeholder="Your name" required>
    <textarea name="text" required></textarea>
    <button type="submit">Submit</button>
  </form>

</section>

</main>

</body>
</html>