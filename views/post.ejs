<!DOCTYPE html>
<html lang="en">
<head>
  <title><%= post.title %> | Voxaria</title>

  <!-- SEO META -->
  <meta name="description" content="<%= ((post.aiSummary || post.content || '').replace(/<[^>]*>/g, '')).substring(0, 160) %>">

  <meta property="og:title" content="<%= post.title %>">
  <meta property="og:description" content="<%= ((post.aiSummary || post.content || '').replace(/<[^>]*>/g, '')).substring(0, 150) %>">
  <meta property="og:image" content="<%= post.mainImage || '/images/default-main.jpg' %>">
  <meta property="og:url" content="<%= baseUrl + '/news/' + post.slug %>">
  <meta property="og:type" content="article">

  <link rel="canonical" href="<%= baseUrl + '/news/' + post.slug %>">
  <link rel="stylesheet" href="/style.css">
</head>

<body>

<%- include('partials/header', { currentPage: 'post' }) %>

<%
const slug = post.slug || post._id;
const shareUrl = baseUrl + '/news/' + slug;
const shareText = encodeURIComponent(post.title);
%>

<main class="article-layout">

<article class="article">

  <h1 class="article-title"><%= post.title %></h1>

  <div class="article-meta">
    <span><strong>Date:</strong> <%= post.createdAt ? new Date(post.createdAt).toDateString() : "" %></span>
    <span><strong>Category:</strong> <%= post.category || "General" %></span>
    <span><strong>Views:</strong> <%= post.analytics?.views || 0 %></span>
    <span><strong>Likes:</strong> <%= post.analytics?.likes || 0 %></span>
  </div>

  <img
    src="<%= post.mainImage || '/images/default-main.jpg' %>"
    class="article-image"
    alt="<%= post.title %>"
  >

  <% if (post.aiSummary) { %>
    <div class="ai-summary">
      <h3>Quick Summary</h3>
      <p><%= post.aiSummary %></p>
    </div>
  <% } %>

  <div class="post-content">
    <%- post.content %>
  </div>

  <!-- SHARE ENGINE -->
  <div class="share-buttons">

    <a target="_blank"
      href="https://wa.me/?text=<%= shareText %>%20<%= encodeURIComponent(shareUrl) %>">
      WhatsApp
    </a>

    <a target="_blank"
      href="https://www.facebook.com/sharer/sharer.php?u=<%= encodeURIComponent(shareUrl) %>">
      Facebook
    </a>

    <a target="_blank"
      href="https://twitter.com/intent/tweet?text=<%= shareText %>&url=<%= encodeURIComponent(shareUrl) %>">
      Twitter
    </a>

    <button onclick="copyLink()">Copy Link</button>

  </div>

  <script>
    function copyLink() {
      const url = "<%= shareUrl %>";

      navigator.clipboard?.writeText(url)
        .then(() => alert("Link copied"))
        .catch(() => {
          const input = document.createElement("input");
          input.value = url;
          document.body.appendChild(input);
          input.select();
          document.execCommand("copy");
          document.body.removeChild(input);
          alert("Link copied");
        });
    }
  </script>

  <!-- LIKE -->
  <div class="post-actions">
    <form action="/like/<%= post.slug %>" method="POST">
      <button type="submit">
        👍 Like (<%= post.analytics?.likes || 0 %>)
      </button>
    </form>
  </div>

</article>

<!-- RELATED -->
<% if (Array.isArray(relatedPosts) && relatedPosts.length > 0) { %>
<section class="related-posts">
  <h2>Related Articles</h2>

  <div class="related-grid">
    <% relatedPosts.forEach(rp => { %>
      <div class="related-card">
        <img src="<%= rp.thumbnail || '/images/default-thumb.jpg' %>" alt="<%= rp.title %>">
        <h3>
          <a href="/news/<%= rp.slug %>"><%= rp.title %></a>
        </h3>
      </div>
    <% }) %>
  </div>
</section>
<% } %>

</main>

</body>
</html>