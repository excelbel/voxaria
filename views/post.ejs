<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">

  <title><%= post?.title || 'Voxaria' %> | Voxaria</title>

  <meta
    name="description"
    content="<%= ((post?.aiSummary || post?.content || '').replace(/<[^>]*>/g, '')).substring(0,160) %>"
  >

  <meta property="og:title" content="<%= post?.title || 'Voxaria' %>">

  <meta
    property="og:description"
    content="<%= ((post?.aiSummary || post?.content || '').replace(/<[^>]*>/g, '')).substring(0,150) %>"
  >

  <meta
    property="og:image"
    content="<%= post?.mainImage || '/images/default-main.jpg' %>"
  >

  <link rel="stylesheet" href="/style.css">
</head>

<body>

<%- include('partials/header', { currentPage: currentPage || 'post' }) %>

<%
const safePost = post || {};
const safeRelatedPosts = Array.isArray(relatedPosts) ? relatedPosts : [];

const slug = safePost.slug || safePost._id || '';
const shareUrl = (baseUrl || '') + '/news/' + slug;
%>

<main class="article-layout">

  <article class="article">

    <h1 class="article-title">
      <%= safePost.title || 'Untitled Post' %>
    </h1>

    <div class="article-meta">

      <span>
        <strong>Date:</strong>
        <%= safePost.createdAt ? new Date(safePost.createdAt).toDateString() : '' %>
      </span>

      <span>
        <strong>Category:</strong>
        <%= safePost.category || 'General' %>
      </span>

      <span>
        <strong>Views:</strong>
        <%= safePost.views || 0 %>
      </span>

    </div>

    <img
      src="<%= safePost.mainImage || '/images/default-main.jpg' %>"
      alt="<%= safePost.title || 'Post Image' %>"
      class="article-image"
    >

    <% if (safePost.aiSummary) { %>
      <div class="ai-summary">
        <h3>Quick Summary</h3>
        <p><%= safePost.aiSummary %></p>
      </div>
    <% } %>

    <div class="post-content">
      <%- safePost.content || '<p>No content available.</p>' %>
    </div>

    <!-- SHARE BUTTONS -->
    <div class="share-buttons">

      <h3>Share this article</h3>

      <a
        class="share-btn whatsapp"
        target="_blank"
        href="https://wa.me/?text=<%= encodeURIComponent((safePost.title || '') + ' ' + shareUrl) %>">
        WhatsApp
      </a>

      <a
        class="share-btn facebook"
        target="_blank"
        href="https://www.facebook.com/sharer/sharer.php?u=<%= encodeURIComponent(shareUrl) %>">
        Facebook
      </a>

      <a
        class="share-btn twitter"
        target="_blank"
        href="https://twitter.com/intent/tweet?text=<%= encodeURIComponent(safePost.title || '') %>&url=<%= encodeURIComponent(shareUrl) %>">
        X (Twitter)
      </a>

      <a
        class="share-btn linkedin"
        target="_blank"
        href="https://www.linkedin.com/sharing/share-offsite/?url=<%= encodeURIComponent(shareUrl) %>">
        LinkedIn
      </a>

      <button class="share-btn copy" onclick="copyLink()">
        Copy Link
      </button>

    </div>

    <script>
      function copyLink() {
        const url = "<%= shareUrl %>";

        navigator.clipboard.writeText(url)
          .then(() => alert("Link copied successfully"))
          .catch(() => alert("Unable to copy link"));
      }
    </script>

  </article>

  <% if (safeRelatedPosts.length > 0) { %>

    <section class="related-posts">

      <h2>Related Articles</h2>

      <div class="related-grid">

        <% safeRelatedPosts.forEach(rp => { %>

          <div class="related-card">

            <img
              src="<%= rp.mainImage || '/images/default-thumb.jpg' %>"
              alt="<%= rp.title %>"
            >

            <h3>
              <a href="/news/<%= rp.slug || rp._id %>">
                <%= rp.title %>
              </a>
            </h3>

          </div>

        <% }) %>

      </div>

    </section>

  <% } %>

</main>

</body>
</html>