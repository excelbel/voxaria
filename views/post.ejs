<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">

  <title><%= post?.title || 'Voxaria' %> | Voxaria</title>

  <meta
    name="description"
    content="<%= ((post?.aiSummary || post?.content || '').replace(/<[^>]*>/g, '')).substring(0,160) %>"
  >

  <meta property="og:title" content="<%= post?.title || 'Voxaria' %>">

  <meta
    property="og:description"
    content="<%= ((post?.aiSummary || post?.content || '').replace(/<[^>]*>/g, '')).substring(0,150) %>"
  >

  <meta
    property="og:image"
    content="<%= post?.mainImage || '/images/default-main.jpg' %>"
  >

  <link rel="stylesheet" href="/style.css">

  <button id="installAppBtn" onclick="installVoxariaApp()" style="display:none; background:#007bff; color:#fff; border:none; padding:8px 16px; border-radius:6px; cursor:pointer;">
  📲 Install App
</button>

<!-- ============================
     PWA META TAGS
     Add inside <head> of EVERY page
     (index.ejs, post.ejs, category.ejs)
============================ -->

<!-- Web App Manifest -->
<link rel="manifest" href="/manifest.json">

<!-- Theme color (browser UI / status bar) -->
<meta name="theme-color" content="#007bff">

<!-- Favicon -->
<link rel="icon" type="image/png" sizes="32x32" href="/icons/favicon-32x32.png">

<!-- iOS support -->
<link rel="apple-touch-icon" href="/icons/apple-touch-icon.png">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="VOXARIA">

<!-- Android / Chrome -->
<meta name="mobile-web-app-capable" content="yes">

<!-- Viewport (if not already present) -->
<meta name="viewport" content="width=device-width, initial-scale=1.0">


<!-- ============================
     SERVICE WORKER REGISTRATION
     Add this script before </body>
     on EVERY page
============================ -->
<script>
  if ('serviceWorker' in navigator) {
    window.addEventListener('load', () => {
      navigator.serviceWorker.register('/service-worker.js')
        .then(reg => console.log('Service worker registered:', reg.scope))
        .catch(err => console.error('Service worker registration failed:', err));
    });
  }

  // Optional: "Install App" prompt handling
  let deferredPrompt;
  window.addEventListener('beforeinstallprompt', (e) => {
    e.preventDefault();
    deferredPrompt = e;
    const installBtn = document.getElementById('installAppBtn');
    if (installBtn) installBtn.style.display = 'inline-block';
  });

  function installVoxariaApp() {
    if (!deferredPrompt) return;
    deferredPrompt.prompt();
    deferredPrompt.userChoice.then(() => {
      deferredPrompt = null;
      const installBtn = document.getElementById('installAppBtn');
      if (installBtn) installBtn.style.display = 'none';
    });
  }
</script>

</head>

<body>

<%- include('partials/header', { currentPage: currentPage || 'post' }) %>

<%
const safePost = post || {};
const safeRelatedPosts = Array.isArray(relatedPosts) ? relatedPosts : [];

const slug = safePost.slug || safePost._id || '';
const shareUrl = (baseUrl || '') + '/news/' + slug;
%>

<main class="article-layout">

  <article class="article">

    <h1 class="article-title">
      <%= safePost.title || 'Untitled Post' %>
    </h1>

    <div class="article-meta">

      <span>
        <strong>Date:</strong>
        <%= safePost.createdAt ? new Date(safePost.createdAt).toDateString() : '' %>
      </span>

      <span>
        <strong>Category:</strong>
        <%= safePost.category || 'General' %>
      </span>

      <span>
        <strong>Views:</strong>
        <%= safePost.views || 0 %>
      </span>

    </div>

    <img
      src="<%= safePost.mainImage || '/images/default-main.jpg' %>"
      alt="<%= safePost.title || 'Post Image' %>"
      class="article-image"
    >

    <% if (safePost.aiSummary) { %>
      <div class="ai-summary">
        <h3>Quick Summary</h3>
        <p><%= safePost.aiSummary %></p>
      </div>
    <% } %>

    <div class="post-content">
      <%- safePost.content || '<p>No content available.</p>' %>
    </div>

    <!-- SHARE BUTTONS -->
    <div class="share-buttons">

      <h3>Share this article</h3>

      <a
        class="share-btn whatsapp"
        target="_blank"
        href="https://wa.me/?text=<%= encodeURIComponent((safePost.title || '') + ' ' + shareUrl) %>">
        WhatsApp
      </a>

      <a
        class="share-btn facebook"
        target="_blank"
        href="https://www.facebook.com/sharer/sharer.php?u=<%= encodeURIComponent(shareUrl) %>">
        Facebook
      </a>

      <a
        class="share-btn twitter"
        target="_blank"
        href="https://twitter.com/intent/tweet?text=<%= encodeURIComponent(safePost.title || '') %>&url=<%= encodeURIComponent(shareUrl) %>">
        X (Twitter)
      </a>

      <a
        class="share-btn linkedin"
        target="_blank"
        href="https://www.linkedin.com/sharing/share-offsite/?url=<%= encodeURIComponent(shareUrl) %>">
        LinkedIn
      </a>

      <button class="share-btn copy" onclick="copyLink()">
        Copy Link
      </button>

    </div>

    <script>
      function copyLink() {
        const url = "<%= shareUrl %>";

        navigator.clipboard.writeText(url)
          .then(() => alert("Link copied successfully"))
          .catch(() => alert("Unable to copy link"));
      }
    </script>

  </article>

  <% if (safeRelatedPosts.length > 0) { %>

    <section class="related-posts">

      <h2>Related Articles</h2>

      <div class="related-grid">

        <% safeRelatedPosts.forEach(rp => { %>

          <div class="related-card">

            <img
              src="<%= rp.mainImage || '/images/default-thumb.jpg' %>"
              alt="<%= rp.title %>"
            >

            <h3>
              <a href="/news/<%= rp.slug || rp._id %>">
                <%= rp.title %>
              </a>
            </h3>

          </div>

        <% }) %>

      </div>

    </section>

  <% } %>

</main>

</body>
</html>