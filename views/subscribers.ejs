<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Subscribers - VOXARIA Admin</title>
  <style>
    body { font-family: Arial, sans-serif; background: #f4f6f9; margin: 0; padding: 20px; }
    .container { max-width: 900px; margin: auto; }
    .header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; }
    .back { text-decoration: none; background: #007bff; color: #fff; padding: 10px 15px; border-radius: 5px; }
    .card { background: #fff; padding: 20px; border-radius: 8px; box-shadow: 0 2px 10px rgba(0,0,0,.08); }
    table { width: 100%; border-collapse: collapse; }
    th, td { padding: 12px 15px; text-align: left; border-bottom: 1px solid #eee; }
    th { background: #f4f6f9; font-weight: bold; font-size: 13px; color: #555; }
    tr:hover { background: #f9f9f9; }
    .count { font-size: 14px; color: #666; margin-bottom: 16px; }
  </style>
</head>
<body>
<div class="container">
  <div class="header">
    <h1>Newsletter Subscribers</h1>
    <a href="/admin" class="back">← Back to Admin</a>
  </div>

  <div class="card">
    <p class="count">Total subscribers: <strong><%= subscribers.length %></strong></p>

    <% if (subscribers.length > 0) { %>
    <table>
      <thead>
        <tr>
          <th>#</th>
          <th>Email</th>
          <th>Name</th>
          <th>Subscribed</th>
        </tr>
      </thead>
      <tbody>
        <% subscribers.forEach((sub, i) => { %>
        <tr>
          <td><%= i + 1 %></td>
          <td><%= sub.email %></td>
          <td><%= sub.name || "—" %></td>
          <td><%= new Date(sub.createdAt).toDateString() %></td>
        </tr>
        <% }) %>
      </tbody>
    </table>
    <% } else { %>
      <p>No subscribers yet.</p>
    <% } %>
  </div>
</div>
</body>
</html>
