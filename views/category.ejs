<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Category: <%= category %> - VOXARIA</title>
  <link rel="stylesheet" href="/style.css">
</head>

<body>

<%- include('partials/header', { currentPage: currentPage }) %>

<main class="container-main">

  <section class="latest-posts">
    <h2>Category: <%= category %></h2>

    <% if (!Array.isArray(posts) || posts.length === 0) { %>
      <p>No articles found in this category.</p>
    <% } else { %>

      <% posts.forEach(post => { %>
        <div class="card">

          <% if (post.thumbnail) { %>
            <img 
              src="<%= post.thumbnail %>" 
              alt="<%= post.title %>" 
              style="width:100%; max-height:200px; object-fit:cover; border-radius:5px;"
            >
          <% } else { %>
            <img 
              src="/images/default-thumb.jpg" 
              alt="No image" 
              style="width:100%; max-height:200px; object-fit:cover; border-radius:5px;"
            >
          <% } %>

          <h3>
            <a href="/news/<%= post.slug || post._id %>">
              <%= post.title %>
            </a>
          </h3>

          <p>
            <strong>Date:</strong>
            <%= post.date ? new Date(post.date).toDateString() : "No date" %>
          </p>

          <p><strong>Author:</strong> <%= post.author || "Admin" %></p>

          <p><strong>Views:</strong> <%= post.views || 0 %></p>

          <a href="/news/<%= post.slug || post._id %>">Read Article</a>

        </div>
      <% }) %>

    <% } %>

    <!-- PAGINATION -->
    <div class="pagination" style="margin-top:20px; display:flex; justify-content:center; gap:10px;">

      <% if (page > 1) { %>
        <a href="/category/<%= category %>?page=<%= page - 1 %>">Previous</a>
      <% } %>

      <span>Page <%= page || 1 %> of <%= totalPages || 1 %></span>

      <% if (page < totalPages) { %>
        <a href="/category/<%= category %>?page=<%= page + 1 %>">Next</a>
      <% } %>

    </div>

  </section>

  <!-- SIDEBAR -->
  <aside class="sidebar">

    <div class="widget">
      <h3>Recent Posts</h3>

      <ul>
        <% if (Array.isArray(recentPosts)) { %>
          <% safeRecentPosts.forEach(rp => { %>
            <li>
              <a href="/news/<%= rp.slug || rp._id %>">
                <%= rp.title %>
              </a>
            </li>
          <% }) %>
        <% } %>
      </ul>
    </div>

    <div class="widget">
      <h3>Trending</h3>

      <ul>
        <% if (Array.isArray(trendingPosts)) { %>
          <% safeTrendingPosts.forEach(tp => { %>
            <li>
              <a href="/news/<%= tp.slug || tp._id %>">
                <%= tp.title %>
              </a>
            </li>
          <% }) %>
        <% } %>
      </ul>
    </div>

    <% if (randomPost) { %>
      <div class="widget">
        <h3>Featured</h3>

        <a href="/news/<%= randomPost.slug || randomPost._id %>">

          <img 
            src="<%= randomPost.thumbnail || '/images/default-thumb.jpg' %>" 
            alt="<%= randomPost.title %>" 
            style="width:100%; border-radius:5px;"
          >

          <p><%= randomPost.title %></p>

        </a>
      </div>
    <% } %>

  </aside>

</main>

</body>
</html>