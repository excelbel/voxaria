<!DOCTYPE html>

<html lang="en">
<head>
  <meta charset="UTF-8">
  <title><%= category %> | Voxaria</title>
  <link rel="stylesheet" href="/style.css">
</head>

<body>

<%- include('partials/header', { currentPage: category }) %>

<div class="article-layout">

  <h1 style="margin-bottom:30px;">
    <%= category %> News
  </h1>

<% if (posts && posts.length > 0) { %>

```
<div class="container">

  <% posts.forEach(post => { %>

    <div class="card">

      <img
        src="<%= post.mainImage || '/images/default-main.jpg' %>"
        alt="<%= post.title %>"
      >

      <h3>
        <a href="/news/<%= post.slug || post._id %>">
          <%= post.title %>
        </a>
      </h3>

      <p>
        <%= (post.aiSummary || '').substring(0, 150) %>...
      </p>

      <p>
        <strong>Date:</strong>
        <%= post.createdAt ? new Date(post.createdAt).toDateString() : '' %>
      </p>

      <a href="/news/<%= post.slug || post._id %>">
        Read Full Article
      </a>

    </div>

  <% }) %>

</div>
```

<% } else { %>

```
<div class="widget">
  <h3>No Articles Found</h3>
  <p>
    There are currently no articles in the
    <strong><%= category %></strong> category.
  </p>
</div>
```

<% } %>

</div>

<footer class="bottom-links">
  <p>© 2026 Voxaria. All Rights Reserved.</p>
</footer>

</body>
</html>
