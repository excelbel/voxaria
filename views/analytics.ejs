<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Analytics Dashboard - VOXARIA</title>
<link rel="stylesheet" href="/style.css">

<style>
body {
  font-family: Arial;
  background: #f4f4f4;
  padding: 20px;
}

.dashboard {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 15px;
}

.card {
  background: white;
  padding: 20px;
  border-radius: 6px;
  box-shadow: 0 2px 6px rgba(0,0,0,0.1);
}

h2 {
  margin-bottom: 10px;
}

.top-posts li {
  margin-bottom: 8px;
}
</style>
</head>

<body>

<h1>Admin Analytics Dashboard</h1>

<div class="dashboard">

  <div class="card">
    <h2>Total Posts</h2>
    <h1><%= totalPosts %></h1>
  </div>

  <div class="card">
    <h2>Total Views</h2>
    <h1><%= totalViews %></h1>
  </div>

  <div class="card">
    <h2>Total Shares</h2>
    <h1><%= totalShares %></h1>
  </div>

</div>

<br>

<div class="card">
  <h2>Top Performing Posts</h2>
  <ul class="top-posts">
    <% topPosts.forEach(p => { %>
      <li><%= p.title %> - <b><%= p.views %> views</b></li>
    <% }) %>
  </ul>
</div>

<br>

<div class="card">
  <h2>Recent Posts</h2>
  <ul>
    <% dailyPosts.forEach(p => { %>
      <li><%= p.title %> - <%= new Date(p.date).toDateString() %></li>
    <% }) %>
  </ul>
</div>

</body>
</html>