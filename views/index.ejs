<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>VOXARIA Blog</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>

<%- include('partials/header', { currentPage: currentPage }) %>

<%
const recentPosts = Array.isArray(typeof recentPosts !== "undefined" ? recentPosts : null) ? recentPosts : [];
const randomPost = typeof randomPost !== "undefined" ? randomPost : null;
const breakingNews = Array.isArray(typeof breakingNews !== "undefined" ? breakingNews : null) ? breakingNews : [];
const featuredGrid = Array.isArray(typeof featuredGrid !== "undefined" ? featuredGrid : null) ? featuredGrid : [];
const posts = Array.isArray(typeof posts !== "undefined" ? posts : null) ? posts : [];
const trendingPosts = Array.isArray(typeof trendingPosts !== "undefined" ? trendingPosts : null) ? trendingPosts : [];
%>

<!-- BREAKING NEWS -->
<% if (breakingNews.length > 0) { %>
<div class="breaking-news">
  <span class="breaking-label">BREAKING</span>

  <div class="ticker-wrapper">
    <div class="ticker-track">
      <% breakingNews.forEach(bn => { %>
        <a href="/post/<%= bn.slug || bn._id %>">
          <%= bn.title %>
        </a>
      <% }) %>
    </div>
  </div>
</div>
<% } %>

<!-- HERO SECTION -->
<div class="hero-featured">

  <% if (featuredPost) { %>
  <div class="hero-card">
    <a href="/post/<%= featuredPost.slug || featuredPost._id %>">
      <img src="<%= featuredPost.mainImage || '/images/default-main.jpg' %>" alt="<%= featuredPost.title %>">
      <div class="overlay">
        <h2><%= featuredPost.title %></h2>
      </div>
    </a>
  </div>
  <% } %>

  <% if (featuredGrid.length > 0) { %>
    <% featuredGrid.forEach(fg => { %>
    <div class="featured-card">
      <a href="/post/<%= fg.slug || fg._id %>">
        <img src="<%= fg.mainImage || '/images/default-main.jpg' %>" alt="<%= fg.title %>">
        <div class="overlay">
          <h3><%= fg.title %></h3>
        </div>
      </a>
    </div>
    <% }) %>
  <% } %>

</div>

<!-- MAIN CONTENT -->
<main class="container-main">

  <section class="latest-posts">

    <% if (posts.length > 0) { %>
      <% posts.forEach(post => { %>
        <div class="card">

          <img 
            src="<%= post.thumbnail || '/images/default-thumb.jpg' %>" 
            alt="<%= post.title %>"
            style="width:100%; max-height:200px; object-fit:cover; border-radius:5px;"
          >

          <h3>
            <a href="/post/<%= post.slug || post.slug %>">
              <%= post.title %>
            </a>
          </h3>

          <p><strong>Date:</strong> <%= new Date(post.createdAt || post.date).toDateString() %></p>
          <p><strong>Author:</strong> <%= post.author || 'Admin' %></p>
          <p><strong>Views:</strong> <%= post.views || 0 %></p>

        </div>
      <% }) %>
    <% } else { %>
      <p>No posts available.</p>
    <% } %>

  </section>

  <!-- SIDEBAR -->
  <aside class="sidebar">

    <div class="widget">
      <h3>Recent Posts</h3>
      <ul>
        <% recentPosts.forEach(rp => { %>
          <li>
            <a href="/post/<%= rp.slug || rp._id %>">
              <%= rp.title %>
            </a>
          </li>
        <% }) %>
      </ul>
    </div>

    <div class="widget">
      <h3>Trending</h3>
      <ul>
        <% trendingPosts.forEach(tp => { %>
          <li>
            <a href="/post/<%= tp.slug || tp._id %>">
              <%= tp.title %>
            </a>
          </li>
        <% }) %>
      </ul>
    </div>

    <% if (randomPost) { %>
    <div class="widget">
      <h3>Featured</h3>
      <a href="/post/<%= randomPost.slug || randomPost._id %>">
        <img 
          src="<%= randomPost.thumbnail || '/images/default-thumb.jpg' %>" 
          style="width:100%; border-radius:5px;"
        >
        <p><%= randomPost.title %></p>
      </a>
    </div>
    <% } %>

  </aside>

</main>

<footer class="bottom-links">
  <p>© 2026 VOXARIA Blog. All Rights Reserved.</p>

  <div class="socials">
    <h3>Contact</h3>
    <p>Anambra State, Nigeria</p>
    <p>Email: info@voxaria.org</p>
    <p><a href="https://wa.me/2349012567912">WhatsApp</a></p>
    <p><a href="https://web.facebook.com/voxaria">Facebook</a></p>
  </div>
</footer>

<script>
setInterval(() => location.reload(), 60000);
</script>

</body>
</html>