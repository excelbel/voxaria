<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>VOXARIA Blog</title>
  <link rel="stylesheet" href="/style.css">
<button id="installAppBtn" onclick="installVoxariaApp()" style="display:none; background:#007bff; color:#fff; border:none; padding:8px 16px; border-radius:6px; cursor:pointer;">
  📲 Install App
</button>
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-LL7FKPRF2W"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-LL7FKPRF2W');
  </script>

  <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-3628162691989275"
        crossorigin="anonymous"></script>

  <style>
    /* Newsletter widget */
    .newsletter-widget {
      background: linear-gradient(135deg, #007bff, #0056b3);
      color: #fff;
      border-radius: 10px;
      padding: 24px 20px;
      margin-bottom: 24px;
      text-align: center;
    }
    .newsletter-widget h3 {
      margin: 0 0 6px;
      font-size: 18px;
    }
    .newsletter-widget p {
      margin: 0 0 16px;
      font-size: 13px;
      opacity: .85;
    }
    .newsletter-widget input[type="text"],
    .newsletter-widget input[type="email"] {
      width: 100%;
      padding: 10px 12px;
      border: none;
      border-radius: 6px;
      margin-bottom: 10px;
      font-size: 14px;
      box-sizing: border-box;
    }
    .newsletter-widget button {
      width: 100%;
      padding: 11px;
      background: #fff;
      color: #007bff;
      border: none;
      border-radius: 6px;
      font-weight: bold;
      font-size: 14px;
      cursor: pointer;
    }
    .newsletter-widget button:hover {
      background: #f0f0f0;
    }
    .newsletter-msg {
      margin-top: 10px;
      font-size: 13px;
      font-weight: bold;
    }

    /* Newsletter banner (inline in feed) */
    .newsletter-banner {
      background: linear-gradient(135deg, #007bff, #0056b3);
      color: #fff;
      border-radius: 10px;
      padding: 30px 24px;
      margin: 20px 0;
      text-align: center;
    }
    .newsletter-banner h2 { margin: 0 0 8px; font-size: 22px; }
    .newsletter-banner p  { margin: 0 0 18px; opacity: .85; }
    .newsletter-banner .banner-row {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
      justify-content: center;
    }
    .newsletter-banner input {
      flex: 1;
      min-width: 200px;
      padding: 11px 14px;
      border: none;
      border-radius: 6px;
      font-size: 14px;
    }
    .newsletter-banner button {
      padding: 11px 24px;
      background: #fff;
      color: #007bff;
      border: none;
      border-radius: 6px;
      font-weight: bold;
      font-size: 14px;
      cursor: pointer;
    }
    .newsletter-banner button:hover { background: #f0f0f0; }
  </style>

  <link rel="manifest" href="/manifest.json">
  <meta name="theme-color" content="#007bff">
  <link rel="icon" type="image/png" sizes="32x32" href="/icons/favicon-32x32.png">
  <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="VOXARIA">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <script>
    if ('serviceWorker' in navigator) {
      window.addEventListener('load', () => {
        navigator.serviceWorker.register('/service-worker.js')
          .then(reg => console.log('Service worker registered:', reg.scope))
          .catch(err => console.error('Service worker registration failed:', err));
      });
    }

    let deferredPrompt;
    window.addEventListener('beforeinstallprompt', (e) => {
      e.preventDefault();
      deferredPrompt = e;
      const installBtn = document.getElementById('installAppBtn');
      if (installBtn) installBtn.style.display = 'inline-block';
    });

    function installVoxariaApp() {
      if (!deferredPrompt) return;
      deferredPrompt.prompt();
      deferredPrompt.userChoice.then(() => {
        deferredPrompt = null;
        const installBtn = document.getElementById('installAppBtn');
        if (installBtn) installBtn.style.display = 'none';
      });
    }
  </script>
</head>
<body>

<%- include('partials/header', { currentPage: currentPage }) %>

<%
const safeArray = (v) => Array.isArray(v) ? v : [];
const safePosts          = safeArray(posts);
const safeBreakingNews   = safeArray(breakingNews);
const safeFeaturedGrid   = safeArray(featuredGrid);
const safeRecentPosts    = safeArray(recentPosts);
const safeTrendingPosts  = safeArray(trendingPosts);
const safeRandomPost   = typeof randomPost   !== "undefined" ? randomPost   : null;
const safeFeaturedPost = typeof featuredPost !== "undefined" ? featuredPost : null;
%>

<% if (safeBreakingNews.length > 0) { %>
<div class="breaking-news">
  <span class="breaking-label">BREAKING</span>
  <div class="ticker-wrapper">
    <div class="ticker-track">
      <% safeBreakingNews.forEach(bn => { %>
        <a href="/news/<%= bn.slug || bn._id %>"><%= bn.title %></a>
      <% }) %>
    </div>
  </div>
</div>
<% } %>

<div class="hero-featured">
  <% if (safeFeaturedPost) { %>
  <div class="hero-card">
    <a href="/news/<%= safeFeaturedPost.slug || safeFeaturedPost._id %>">
      <img src="<%= safeFeaturedPost.mainImage || 'https://placehold.co/800x400?text=No+Image' %>"
           alt="<%= safeFeaturedPost.title %>">
      <div class="overlay"><h2><%= safeFeaturedPost.title %></h2></div>
    </a>
  </div>
  <% } %>

  <% safeFeaturedGrid.forEach(fg => { %>
  <div class="featured-card">
    <a href="/news/<%= fg.slug || fg._id %>">
      <img src="<%= fg.mainImage || 'https://placehold.co/800x400?text=No+Image' %>"
           alt="<%= fg.title %>">
      <div class="overlay"><h3><%= fg.title %></h3></div>
    </a>
  </div>
  <% }) %>
</div>

<main class="container-main">
  <section class="latest-posts">
    <% safePosts.forEach((post, index) => { %>
      <div class="card">
        <img src="<%= post.mainImage || 'https://placehold.co/400x200?text=No+Image' %>"
             alt="<%= post.title %>"
             onerror="this.onerror=null;this.src='/voxaria-logo.png'"
             style="width:100%; max-height:200px; object-fit:cover; border-radius:5px;">
        <h3>
          <a href="/news/<%= post.slug %>"><%= post.title %></a>
        </h3>
        <p><strong>Date:</strong> <%= new Date(post.createdAt || post.date).toDateString() %></p>
        <p><strong>Author:</strong> <%= post.author || 'Admin' %></p>
        <p><strong>Views:</strong> <%= post.views || 0 %></p>
      </div>

      <% if (index === 4) { %>
      <div class="newsletter-banner">
        <h2>📬 Stay Informed</h2>
        <p>Get the latest Nigerian and world news delivered straight to your inbox.</p>
        <div class="banner-row">
          <input type="email" id="bannerEmail" placeholder="Enter your email address">
          <button onclick="subscribeBanner()">Subscribe Free</button>
        </div>
        <div id="bannerMsg" class="newsletter-msg"></div>
      </div>
      <% } %>
    <% }) %>

    <% if (safePosts.length === 0) { %>
      <p>No posts available.</p>
    <% } %>
  </section>

  <aside class="sidebar">
    <div class="newsletter-widget">
      <h3>📬 Newsletter</h3>
      <p>Get top stories delivered to your inbox daily.</p>
      <input type="text" id="subName" placeholder="Your name (optional)">
      <input type="email" id="subEmail" placeholder="Your email address">
      <button onclick="subscribeWidget()">Subscribe Free</button>
      <div id="widgetMsg" class="newsletter-msg"></div>
    </div>

    <div class="widget">
      <h3>Recent Posts</h3>
      <ul>
        <% safeRecentPosts.forEach(rp => { %>
          <li><a href="/news/<%= rp.slug || rp._id %>"><%= rp.title %></a></li>
        <% }) %>
      </ul>
    </div>

    <div class="widget">
      <h3>Trending</h3>
      <ul>
        <% safeTrendingPosts.forEach(tp => { %>
          <li><a href="/news/<%= tp.slug || tp._id %>"><%= tp.title %></a></li>
        <% }) %>
      </ul>
    </div>

    <% if (safeRandomPost) { %>
    <div class="widget">
      <h3>Featured</h3>
      <a href="/news/<%= safeRandomPost.slug || safeRandomPost._id %>">
        <img src="<%= safeRandomPost.mainImage || 'https://placehold.co/400x200?text=No+Image' %>"
             onerror="this.onerror=null;this.src='/voxaria-logo.png'"
             style="width:100%; border-radius:5px;">
        <p><%= safeRandomPost.title %></p>
      </a>
    </div>
    <% } %>
  </aside>
</main>

<footer class="bottom-links">
  <div style="margin-bottom: 10px;">
    <a href="/about">About</a> | 
    <a href="/contact">Contact</a> | 
    <a href="/privacy-policy">Privacy Policy</a>
  </div>
  <p>© 2026 VOXARIA Blog. All Rights Reserved.</p>
  <div class="socials">
    <h3>Contact</h3>
    <p>Anambra State, Nigeria</p>
    <p>Email: info@voxaria.org</p>
    <p><a href="https://wa.me/2349012567912">WhatsApp</a></p>
    <p><a href="https://web.facebook.com/voxaria">Facebook</a></p>
  </div>
</footer>

<script>
setInterval(() => location.reload(), 60000);

async function subscribe(email, name, msgId) {
  const msgEl = document.getElementById(msgId);
  if (!email || !email.includes("@")) {
    msgEl.style.color = "#ffcccc";
    msgEl.textContent = "Please enter a valid email.";
    return;
  }
  msgEl.style.color = "#fff";
  msgEl.textContent = "Subscribing...";

  try {
    const res = await fetch("/subscribe", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ email, name })
    });
    const data = await res.json();
    if (res.ok) {
      msgEl.style.color = "#ccffcc";
      msgEl.textContent = "✅ " + (data.message || "Subscribed successfully!");
    } else {
      msgEl.style.color = "#ffcccc";
      msgEl.textContent = "❌ " + (data.error || "Something went wrong.");
    }
  } catch {
    msgEl.style.color = "#ffcccc";
    msgEl.textContent = "❌ Network error. Please try again.";
  }
}

function subscribeWidget() {
  const email = document.getElementById("subEmail").value.trim();
  const name  = document.getElementById("subName").value.trim();
  subscribe(email, name, "widgetMsg");
}

function subscribeBanner() {
  const email = document.getElementById("bannerEmail").value.trim();
  subscribe(email, "", "bannerMsg");
}
</script>

</body>
</html>