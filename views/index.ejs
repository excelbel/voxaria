<script>
async function subscribe(email, name, msgId) {
  const msgEl = document.getElementById(msgId);
  if (!email || !email.includes("@")) {
    msgEl.style.color = "#fca5a5";
    msgEl.textContent = "Please enter a valid email.";
    return;
  }
  msgEl.textContent = "Subscribing...";
  try {
    const res = await fetch("/subscribe", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ email, name })
    });
    const data = await res.json();
    msgEl.style.color = res.ok ? "#86efac" : "#fca5a5";
    msgEl.textContent = res.ok
      ? "✅ " + (data.message || "Subscribed successfully!")
      : "❌ " + (data.error || "Something went wrong.");
  } catch {
    msgEl.style.color = "#fca5a5";
    msgEl.textContent = "❌ Network error. Try again.";
  }
}
function subscribeWidget() {
  subscribe(
    document.getElementById("subEmail").value.trim(),
    document.getElementById("subName").value.trim(),
    "widgetMsg"
  );
}
function subscribeBanner() {
  subscribe(document.getElementById("bannerEmail").value.trim(), "", "bannerMsg");
}

if ('serviceWorker' in navigator) {
  window.addEventListener('load', () => {
    navigator.serviceWorker.register('/service-worker.js')
      .then(r => console.log('SW:', r.scope))
      .catch(e => console.error('SW:', e));
  });
}
let deferredPrompt;
window.addEventListener('beforeinstallprompt', e => {
  e.preventDefault();
  deferredPrompt = e;
  const btn = document.getElementById('installAppBtn');
  if (btn) btn.style.display = 'block';
});
function installVoxariaApp() {
  if (!deferredPrompt) return;
  deferredPrompt.prompt();
  deferredPrompt.userChoice.then(() => {
    deferredPrompt = null;
    const btn = document.getElementById('installAppBtn');
    if (btn) btn.style.display = 'none';
  });
}
</script>
