<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>VOXARIA — Nigeria's Voice to the World</title>
  <meta name="description" content="Latest breaking news from Nigeria and around the world — politics, sports, entertainment, technology, health and more.">

  <!-- Google Analytics -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-LL7FKPRF2W"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-LL7FKPRF2W');
  </script>

  <!-- AdSense -->
  <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-3628162691989275" crossorigin="anonymous"></script>

  <!-- PWA -->
  <link rel="manifest" href="/manifest.json">
  <meta name="theme-color" content="#0a0f1e">
  <link rel="icon" type="image/png" sizes="32x32" href="/icons/favicon-32x32.png">
  <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="VOXARIA">
  <meta name="mobile-web-app-capable" content="yes">

  <link rel="stylesheet" href="/style.css">
</head>
<body>

<%- include('partials/header', { currentPage: currentPage }) %>

<%
const safeArray = (v) => Array.isArray(v) ? v : [];
const safePosts         = safeArray(posts);
const safeBreakingNews  = safeArray(breakingNews);
const safeFeaturedGrid  = safeArray(featuredGrid);
const safeRecentPosts   = safeArray(recentPosts);
const safeTrendingPosts = safeArray(trendingPosts);
const safeRandomPost    = typeof randomPost   !== "undefined" ? randomPost   : null;
const safeFeaturedPost  = typeof featuredPost !== "undefined" ? featuredPost : null;
const LOGO = '/voxaria-logo.png';

function timeAgo(date) {
  const diff = Math.floor((Date.now() - new Date(date)) / 1000);
  if (diff < 60) return diff + 's ago';
  if (diff < 3600) return Math.floor(diff/60) + 'm ago';
  if (diff < 86400) return Math.floor(diff/3600) + 'h ago';
  return Math.floor(diff/86400) + 'd ago';
}
%>

<!-- BREAKING NEWS -->
<% if (safeBreakingNews.length > 0) { %>
<div class="breaking-news">
  <span class="breaking-label">BREAKING</span>
  <div class="ticker-wrapper">
    <div class="ticker-track">
      <% safeBreakingNews.forEach(bn => { %>
        <a href="/news/<%= bn.slug || bn._id %>">🔴 <%= bn.title %></a>
      <% }) %>
    </div>
  </div>
</div>
<% } %>

<!-- HERO SECTION -->
<div class="hero-featured">

  <% if (safeFeaturedPost) { %>
  <div class="hero-card">
    <a href="/news/<%= safeFeaturedPost.slug || safeFeaturedPost._id %>">
      <img
        src="<%= safeFeaturedPost.mainImage || LOGO %>"
        alt="<%= safeFeaturedPost.title %>"
        onerror="this.onerror=null;this.src='<%= LOGO %>'">
      <div class="overlay">
        <% if (safeFeaturedPost.category) { %>
          <span style="display:inline-block;background:#dc2626;color:#fff;font-size:0.7rem;font-weight:700;text-transform:uppercase;letter-spacing:1px;padding:3px 10px;border-radius:3px;margin-bottom:8px;"><%= safeFeaturedPost.category %></span>
        <% } %>
        <h2><%= safeFeaturedPost.title %></h2>
      </div>
    </a>
  </div>
  <% } %>

  <% safeFeaturedGrid.forEach(fg => { %>
  <div class="featured-card">
    <a href="/news/<%= fg.slug || fg._id %>">
      <img
        src="<%= fg.mainImage || LOGO %>"
        alt="<%= fg.title %>"
        onerror="this.onerror=null;this.src='<%= LOGO %>'">
      <div class="overlay">
        <h3><%= fg.title %></h3>
      </div>
    </a>
  </div>
  <% }) %>

</div>

<!-- ADSENSE TOP -->
<div style="max-width:1300px;margin:0 auto 20px;padding:0 20px;text-align:center;">
  <ins class="adsbygoogle"
    style="display:block"
    data-ad-client="ca-pub-3628162691989275"
    data-ad-slot="auto"
    data-ad-format="auto"
    data-full-width-responsive="true"></ins>
  <script>(adsbygoogle = window.adsbygoogle || []).push({});</script>
</div>

<!-- MAIN CONTENT -->
<div class="container-main">

  <!-- LATEST POSTS -->
  <section class="latest-posts">

    <div class="section-header">
      <h2>Latest Stories</h2>
    </div>

    <div class="posts-grid">
      <% safePosts.forEach((post, index) => { %>

        <div class="card">
          <a href="/news/<%= post.slug %>">
            <img
              src="<%= post.mainImage || LOGO %>"
              alt="<%= post.title %>"
              onerror="this.onerror=null;this.src='<%= LOGO %>'">
          </a>
          <div class="card-body">
            <span class="card-category"><%= post.category || 'News' %></span>
            <h3><a href="/news/<%= post.slug %>"><%= post.title %></a></h3>
            <div class="card-meta">
              <span>👤 <%= post.author || 'VOXARIA' %></span>
              <span>🕐 <%= timeAgo(post.createdAt) %></span>
              <span>👁 <%= post.views || 0 %></span>
            </div>
          </div>
        </div>

        <!-- Newsletter banner after 6th post -->
        <% if (index === 5) { %>
        <div class="newsletter-banner" style="grid-column:1/-1;">
          <h2>📬 Stay Informed</h2>
          <p>Get breaking news from Nigeria and the world delivered to your inbox.</p>
          <div class="banner-row">
            <input type="email" id="bannerEmail" placeholder="Enter your email address">
            <button onclick="subscribeBanner()">Subscribe Free →</button>
          </div>
          <div id="bannerMsg" class="banner-msg"></div>
        </div>
        <% } %>

        <!-- AdSense after every 10 posts -->
        <% if ((index + 1) % 10 === 0) { %>
        <div style="grid-column:1/-1;text-align:center;">
          <ins class="adsbygoogle"
            style="display:block"
            data-ad-client="ca-pub-3628162691989275"
            data-ad-slot="auto"
            data-ad-format="auto"
            data-full-width-responsive="true"></ins>
          <script>(adsbygoogle = window.adsbygoogle || []).push({});</script>
        </div>
        <% } %>

      <% }) %>

      <% if (safePosts.length === 0) { %>
        <div style="grid-column:1/-1;text-align:center;padding:40px;color:#6b7280;">
          <p>No posts available yet. Check back soon!</p>
        </div>
      <% } %>
    </div>

  </section>

  <!-- SIDEBAR -->
  <aside class="sidebar">

    <!-- Install App -->
    <div style="text-align:center;">
      <button id="installAppBtn" onclick="installVoxariaApp()"
        style="display:none;width:100%;background:#0a0f1e;color:#ffd700;border:none;padding:12px;border-radius:8px;font-weight:700;font-size:14px;cursor:pointer;">
        📲 Install VOXARIA App
      </button>
    </div>

    <!-- Newsletter Widget -->
    <div class="newsletter-widget">
      <h3>📬 Daily Newsletter</h3>
      <p>Top stories delivered to your inbox every day.</p>
      <input type="text" id="subName" placeholder="Your name (optional)">
      <input type="email" id="subEmail" placeholder="Your email address">
      <button onclick="subscribeWidget()">Subscribe Free →</button>
      <div id="widgetMsg" class="newsletter-msg"></div>
    </div>

    <!-- Recent Posts -->
    <div class="widget">
      <h3 class="widget-title">Recent Posts</h3>
      <ul>
        <% safeRecentPosts.forEach(rp => { %>
          <li>
            <a href="/news/<%= rp.slug || rp._id %>"><%= rp.title %></a>
          </li>
        <% }) %>
      </ul>
    </div>

    <!-- AdSense sidebar -->
    <div style="text-align:center;">
      <ins class="adsbygoogle"
        style="display:block"
        data-ad-client="ca-pub-3628162691989275"
        data-ad-slot="auto"
        data-ad-format="auto"
        data-full-width-responsive="true"></ins>
      <script>(adsbygoogle = window.adsbygoogle || []).push({});</script>
    </div>

    <!-- Trending -->
    <div class="widget">
      <h3 class="widget-title">🔥 Trending</h3>
      <ul>
        <% safeTrendingPosts.forEach(tp => { %>
          <li>
            <a href="/news/<%= tp.slug || tp._id %>"><%= tp.title %></a>
          </li>
        <% }) %>
      </ul>
    </div>

    <!-- Featured -->
    <% if (safeRandomPost) { %>
    <div class="widget">
      <h3 class="widget-title">⭐ Featured</h3>
      <a href="/news/<%= safeRandomPost.slug || safeRandomPost._id %>">
        <img
          src="<%= safeRandomPost.mainImage || LOGO %>"
          alt="<%= safeRandomPost.title %>"
          onerror="this.onerror=null;this.src='<%= LOGO %>'"
          style="width:100%;height:160px;object-fit:cover;border-radius:8px;margin-bottom:10px;">
        <p style="font-size:0.9rem;font-weight:600;color:#111;line-height:1.4;"><%= safeRandomPost.title %></p>
      </a>
    </div>
    <% } %>

  </aside>

</div>

<!-- FOOTER -->
<footer class="bottom-links">
  <div class="footer-inner">
    <div class="footer-col">
      <h4>VOXARIA</h4>
      <p>Nigeria's Voice to the World — Accurate, Fast, Trusted news from Anambra State, Nigeria.</p>
    </div>
    <div class="footer-col">
      <h4>News</h4>
      <a href="/category/Politics">Politics</a>
      <a href="/category/Security">Security</a>
      <a href="/category/International">International</a>
      <a href="/category/Sports">Sports</a>
    </div>
    <div class="footer-col">
      <h4>More</h4>
      <a href="/category/Technology">Technology</a>
      <a href="/category/Health">Health</a>
      <a href="/category/Finance">Finance</a>
      <a href="/category/Entertainment">Entertainment</a>
    </div>
    <div class="footer-col">
      <h4>Company</h4>
      <a href="/about">About Us</a>
      <a href="/contact">Contact</a>
      <a href="/privacy-policy">Privacy Policy</a>
      <a href="https://wa.me/2349012567912">WhatsApp</a>
      <a href="https://web.facebook.com/voxaria">Facebook</a>
    </div>
  </div>
  <div class="footer-bottom">
    <span>© 2026 VOXARIA Media. All Rights Reserved.</span>
    <span>
      <a href="/privacy-policy">Privacy Policy</a> ·
      <a href="/about">About</a> ·
      <a href="/contact">Contact</a>
    </span>
  </div>
</footer>

<script>
/* Newsletter subscribe */
async function subscribe(email, name, msgId) {
  const msgEl = document.getElementById(msgId);
  if (!email || !email.includes("@")) {
    msgEl.style.color = "#fca5a5";
    msgEl.textContent = "Please enter a valid email.";
    return;
  }
  msgEl.textContent = "Subscribing...";
  try {
    const res = await fetch("/subscribe", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ email, name })
    });
    const data = await res.json();
    msgEl.style.color = res.ok ? "#86efac" : "#fca5a5";
    msgEl.textContent = res.ok
      ? "✅ " + (data.message || "Subscribed!")
      : "❌ " + (data.error || "Something went wrong.");
  } catch {
    msgEl.style.color = "#fca5a5";
    msgEl.textContent = "❌ Network error. Try again.";
  }
}

function subscribeWidget() {
  subscribe(
    document.getElementById("subEmail").value.trim(),
    document.getElementById("subName").value.trim(),
    "widgetMsg"
  );
}

function subscribeBanner() {
  subscribe(document.getElementById("bannerEmail").value.trim(), "", "bannerMsg");
}

/* PWA */
if ('serviceWorker' in navigator) {
  window.addEventListener('load', () => {
    navigator.serviceWorker.register('/service-worker.js')
      .then(r => console.log('SW registered:', r.scope))
      .catch(e => console.error('SW failed:', e));
  });
}

let deferredPrompt;
window.addEventListener('beforeinstallprompt', (e) => {
  e.preventDefault();
  deferredPrompt = e;
  const btn = document.getElementById('installAppBtn');
  if (btn) btn.style.display = 'block';
});

function installVoxariaApp() {
  if (!deferredPrompt) return;
  deferredPrompt.prompt();
  deferredPrompt.userChoice.then(() => {
    deferredPrompt = null;
    const btn = document.getElementById('installAppBtn');
    if (btn) btn.style.display = 'none';
  });
}
</script>

</body>
</html>
