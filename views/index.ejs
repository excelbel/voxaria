<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>VOXARIA — Nigeria's Voice to the World</title>
  <meta name="description" content="Latest breaking news from Nigeria and around the world — politics, sports, entertainment, technology, health and more.">

  <script async src="https://www.googletagmanager.com/gtag/js?id=G-LL7FKPRF2W"></script>
  <script>
    window.dataLayer=window.dataLayer||[];
    function gtag(){dataLayer.push(arguments);}
    gtag('js',new Date());
    gtag('config','G-LL7FKPRF2W');
  </script>
  <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-3628162691989275" crossorigin="anonymous"></script>

  <link rel="manifest" href="/manifest.json">
  <meta name="theme-color" content="#0a0f1e">
  <link rel="icon" type="image/png" sizes="32x32" href="/icons/favicon-32x32.png">
  <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-title" content="VOXARIA">
  <meta name="mobile-web-app-capable" content="yes">

  <link rel="stylesheet" href="/style.css">

  <style>
  /* ── Live Badge ── */
  .live-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: #dc2626;
    color: #fff;
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    padding: 4px 10px;
    border-radius: 4px;
  }
  .live-dot {
    width: 7px;
    height: 7px;
    background: #fff;
    border-radius: 50%;
    animation: livePulse 1s infinite;
    flex-shrink: 0;
  }
  @keyframes livePulse {
    0%,100%{opacity:1;transform:scale(1);}
    50%{opacity:0.4;transform:scale(1.3);}
  }

  /* ── Date Bar ── */
  .date-bar {
    background: #0a0f1e;
    color: rgba(255,255,255,0.6);
    font-size: 0.78rem;
    padding: 6px 40px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }
  .date-bar a {
    color: #ffd700;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.75rem;
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .date-bar a:hover { text-decoration: underline; }

  /* ── Key Headlines Section ── */
  .headlines-section {
    background: #fff;
    border-bottom: 3px solid #f0f2f5;
    padding: 0;
  }
  .headlines-inner {
    max-width: 1300px;
    margin: auto;
    padding: 0 20px;
  }
  .headlines-header {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 16px 0 12px;
    border-bottom: 1px solid #f3f4f6;
  }
  .headlines-title {
    font-size: 0.78rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 1.2px;
    color: #111;
    margin: 0;
  }
  .headlines-date {
    font-size: 0.75rem;
    color: #6b7280;
    margin-left: auto;
  }
  .headlines-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 0;
    padding: 8px 0;
  }
  .headline-item {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    padding: 10px 14px 10px 0;
    border-right: 1px solid #f3f4f6;
    border-bottom: 1px solid #f3f4f6;
  }
  .headline-item:last-child { border-right: none; }
  .headline-num {
    font-size: 1.2rem;
    font-weight: 900;
    color: #e5e7eb;
    line-height: 1;
    flex-shrink: 0;
    min-width: 28px;
  }
  .headline-text {
    font-size: 0.85rem;
    font-weight: 600;
    line-height: 1.45;
    color: #111;
  }
  .headline-text a {
    color: inherit;
    text-decoration: none;
    transition: color 0.2s;
  }
  .headline-text a:hover { color: #2563eb; }
  .headline-cat {
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    color: #dc2626;
    display: block;
    margin-bottom: 3px;
  }

  /* ── Hero Grid ── */
  .hero-featured {
    max-width: 1300px;
    margin: 24px auto;
    padding: 0 20px;
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    grid-template-rows: 1fr 1fr;
    gap: 14px;
  }
  .hero-card {
    grid-row: 1 / 3;
    position: relative;
    border-radius: 14px;
    overflow: hidden;
    background: #111;
    box-shadow: 0 6px 28px rgba(0,0,0,0.18);
    transition: transform 0.3s;
  }
  .hero-card:hover { transform: translateY(-3px); }
  .hero-card img {
    width: 100%;
    height: 440px;
    object-fit: cover;
    object-position: center top;
    display: block;
    transition: transform 0.5s;
  }
  .hero-card:hover img { transform: scale(1.03); }
  .featured-card {
    position: relative;
    border-radius: 11px;
    overflow: hidden;
    background: #111;
    box-shadow: 0 4px 16px rgba(0,0,0,0.12);
    transition: transform 0.3s;
  }
  .featured-card:hover { transform: translateY(-3px); }
  .featured-card img {
    width: 100%;
    height: 205px;
    object-fit: cover;
    object-position: center top;
    display: block;
    transition: transform 0.4s;
  }
  .featured-card:hover img { transform: scale(1.04); }
  .overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 20px 16px 16px;
    background: linear-gradient(to top, rgba(0,0,0,0.88) 0%, rgba(0,0,0,0.3) 60%, transparent 100%);
    color: #fff;
  }
  .hero-card .overlay { padding: 32px 22px 22px; }
  .overlay-cat {
    display: inline-block;
    background: #dc2626;
    color: #fff;
    font-size: 0.65rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 1px;
    padding: 3px 10px;
    border-radius: 3px;
    margin-bottom: 8px;
  }
  .overlay h2 {
    font-size: 1.35rem;
    font-weight: 800;
    line-height: 1.3;
    margin: 0;
    text-shadow: 0 1px 6px rgba(0,0,0,0.5);
  }
  .overlay h3 {
    font-size: 0.95rem;
    font-weight: 700;
    line-height: 1.35;
    margin: 0;
  }
  .overlay-meta {
    font-size: 0.75rem;
    color: rgba(255,255,255,0.7);
    margin-top: 6px;
  }

  /* ── Main Layout ── */
  .container-main {
    max-width: 1300px;
    margin: 0 auto;
    padding: 0 20px 50px;
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: 30px;
    align-items: start;
  }

  /* ── Section Header ── */
  .section-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 18px;
    padding-bottom: 12px;
    border-bottom: 2px solid #e5e7eb;
  }
  .section-header-left {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .section-header-left::before {
    content: '';
    width: 4px;
    height: 20px;
    background: #dc2626;
    border-radius: 2px;
  }
  .section-header h2 {
    font-size: 1.05rem;
    font-weight: 800;
    color: #111;
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }
  .section-header a {
    font-size: 0.78rem;
    color: #2563eb;
    font-weight: 600;
    text-decoration: none;
  }
  .section-header a:hover { text-decoration: underline; }

  /* ── Post Cards ── */
  .posts-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 18px;
  }
  .card {
    background: #fff;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 2px 12px rgba(0,0,0,0.06);
    transition: transform 0.25s, box-shadow 0.25s;
    display: flex;
    flex-direction: column;
  }
  .card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 28px rgba(0,0,0,0.11);
  }
  .card-img-wrap { position: relative; overflow: hidden; }
  .card img {
    width: 100%;
    height: 185px;
    object-fit: cover;
    object-position: center top;
    background: #e5e7eb;
    transition: transform 0.4s;
  }
  .card:hover img { transform: scale(1.04); }
  .card-live-badge {
    position: absolute;
    top: 10px;
    left: 10px;
  }
  .card-body {
    padding: 14px 16px 16px;
    flex: 1;
    display: flex;
    flex-direction: column;
  }
  .card-category {
    font-size: 0.65rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    color: #dc2626;
    margin-bottom: 6px;
  }
  .card h3 {
    font-size: 0.95rem;
    font-weight: 700;
    line-height: 1.45;
    color: #111;
    margin: 0 0 10px;
    flex: 1;
  }
  .card h3 a { color: inherit; transition: color 0.2s; }
  .card h3 a:hover { color: #2563eb; }
  .card-meta {
    display: flex;
    gap: 10px;
    font-size: 0.72rem;
    color: #9ca3af;
    margin-top: auto;
    flex-wrap: wrap;
  }

  /* ── Ad Slot ── */
  .ad-slot {
    margin: 20px 0;
    text-align: center;
    background: #f9fafb;
    border-radius: 8px;
    padding: 8px;
    border: 1px dashed #e5e7eb;
  }
  .ad-slot-label {
    font-size: 0.65rem;
    color: #d1d5db;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 4px;
  }

  /* ── Newsletter Banner ── */
  .newsletter-banner {
    background: linear-gradient(135deg, #0a0f1e 0%, #1e3a8a 50%, #0a0f1e 100%);
    border-radius: 14px;
    padding: 32px 28px;
    margin: 24px 0;
    grid-column: 1 / -1;
    position: relative;
    overflow: hidden;
  }
  .newsletter-banner::before {
    content: '📰';
    position: absolute;
    right: 24px;
    top: 50%;
    transform: translateY(-50%);
    font-size: 5rem;
    opacity: 0.06;
  }
  .newsletter-banner h2 {
    font-size: 1.4rem;
    font-weight: 800;
    color: #fff;
    margin: 0 0 6px;
  }
  .newsletter-banner p { color: rgba(255,255,255,0.75); margin: 0 0 18px; font-size: 0.95rem; }
  .banner-row { display: flex; gap: 10px; flex-wrap: wrap; }
  .banner-row input {
    flex: 1;
    min-width: 200px;
    padding: 12px 16px;
    border: none;
    border-radius: 8px;
    font-size: 14px;
    outline: none;
    background: rgba(255,255,255,0.95);
  }
  .banner-row button {
    padding: 12px 24px;
    background: #ffd700;
    color: #111;
    border: none;
    border-radius: 8px;
    font-weight: 800;
    font-size: 14px;
    cursor: pointer;
    white-space: nowrap;
    transition: background 0.2s;
  }
  .banner-row button:hover { background: #f0c800; }
  .banner-msg { color: #86efac; font-size: 13px; font-weight: 700; margin-top: 10px; }

  /* ── Sidebar ── */
  .sidebar {
    position: sticky;
    top: 80px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .widget {
    background: #fff;
    border-radius: 12px;
    padding: 18px;
    box-shadow: 0 2px 12px rgba(0,0,0,0.06);
  }
  .widget-title {
    font-size: 0.75rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: #111;
    margin: 0 0 14px;
    padding-bottom: 10px;
    border-bottom: 2px solid #f3f4f6;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .widget-title::before {
    content: '';
    width: 3px;
    height: 14px;
    background: #dc2626;
    border-radius: 2px;
    flex-shrink: 0;
  }
  .widget ul { list-style: none; padding: 0; margin: 0; }
  .widget ul li {
    padding: 10px 0;
    border-bottom: 1px solid #f3f4f6;
    display: flex;
    gap: 10px;
    align-items: flex-start;
  }
  .widget ul li:last-child { border-bottom: none; padding-bottom: 0; }
  .widget-num {
    font-size: 1rem;
    font-weight: 900;
    color: #e5e7eb;
    line-height: 1.2;
    flex-shrink: 0;
    min-width: 20px;
  }
  .widget ul li a {
    font-size: 0.85rem;
    font-weight: 600;
    color: #1f2937;
    line-height: 1.4;
    transition: color 0.2s;
  }
  .widget ul li a:hover { color: #2563eb; }

  /* ── Newsletter Widget ── */
  .newsletter-widget {
    background: linear-gradient(135deg, #0a0f1e, #1e3a8a);
    border-radius: 12px;
    padding: 20px 16px;
    text-align: center;
    color: #fff;
  }
  .newsletter-widget h3 { font-size: 1rem; font-weight: 800; margin: 0 0 6px; }
  .newsletter-widget p { font-size: 0.82rem; opacity: 0.8; margin: 0 0 12px; }
  .newsletter-widget input {
    width: 100%;
    padding: 9px 12px;
    border: none;
    border-radius: 6px;
    font-size: 13px;
    margin-bottom: 8px;
    box-sizing: border-box;
    outline: none;
  }
  .newsletter-widget button {
    width: 100%;
    padding: 10px;
    background: #ffd700;
    color: #111;
    border: none;
    border-radius: 6px;
    font-weight: 800;
    font-size: 13px;
    cursor: pointer;
    transition: background 0.2s;
  }
  .newsletter-widget button:hover { background: #f0c800; }
  .newsletter-msg { margin-top: 8px; font-size: 12px; font-weight: 700; }

  /* ── Category Pills ── */
  .category-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 20px;
  }
  .pill {
    display: inline-block;
    padding: 6px 14px;
    background: #fff;
    border: 1.5px solid #e5e7eb;
    border-radius: 20px;
    font-size: 0.78rem;
    font-weight: 600;
    color: #374151;
    text-decoration: none;
    transition: all 0.2s;
    white-space: nowrap;
  }
  .pill:hover {
    background: #0a0f1e;
    color: #ffd700;
    border-color: #0a0f1e;
  }

  /* ── Footer ── */
  .bottom-links {
    background: #0a0f1e;
    color: #fff;
    padding: 48px 20px 24px;
    margin-top: auto;
  }
  .footer-inner {
    max-width: 1300px;
    margin: auto;
    display: grid;
    grid-template-columns: 1.5fr repeat(3, 1fr);
    gap: 32px;
    margin-bottom: 32px;
  }
  .footer-brand .logo {
    font-size: 1.5rem;
    font-weight: 900;
    color: #ffd700;
    letter-spacing: 1px;
    margin-bottom: 10px;
  }
  .footer-brand p {
    font-size: 0.85rem;
    color: rgba(255,255,255,0.55);
    line-height: 1.7;
    margin: 0 0 14px;
  }
  .footer-socials { display: flex; gap: 10px; }
  .footer-social-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    background: rgba(255,255,255,0.08);
    border-radius: 8px;
    color: #fff;
    text-decoration: none;
    font-size: 16px;
    transition: background 0.2s;
  }
  .footer-social-btn:hover { background: rgba(255,215,0,0.2); }
  .footer-col h4 {
    font-size: 0.78rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: #ffd700;
    margin: 0 0 14px;
  }
  .footer-col a {
    display: block;
    font-size: 0.88rem;
    color: rgba(255,255,255,0.6);
    text-decoration: none;
    margin-bottom: 8px;
    transition: color 0.2s;
  }
  .footer-col a:hover { color: #ffd700; }
  .footer-bottom {
    max-width: 1300px;
    margin: auto;
    padding-top: 20px;
    border-top: 1px solid rgba(255,255,255,0.07);
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
    font-size: 0.8rem;
    color: rgba(255,255,255,0.35);
  }
  .footer-bottom a { color: rgba(255,255,255,0.35); text-decoration: none; transition: color 0.2s; }
  .footer-bottom a:hover { color: #ffd700; }

  /* ── Responsive ── */
  @media(max-width:1024px) {
    .hero-featured { grid-template-columns: 1fr; grid-template-rows: auto; }
    .hero-card { grid-row: auto; }
    .hero-card img { height: 300px; }
    .featured-card img { height: 180px; }
    .container-main { grid-template-columns: 1fr; }
    .sidebar { position: static; display: grid; grid-template-columns: repeat(2,1fr); }
    .footer-inner { grid-template-columns: 1fr 1fr; }
  }

  @media(max-width:768px) {
    .date-bar { padding: 6px 16px; }
    .hero-featured { padding: 0 14px; margin: 14px auto; gap: 10px; }
    .hero-card img { height: 220px; }
    .featured-card img { height: 150px; }
    .container-main { padding: 0 14px 30px; }
    .posts-grid { grid-template-columns: 1fr; }
    .sidebar { grid-template-columns: 1fr; }
    .headlines-grid { grid-template-columns: 1fr 1fr; }
    .footer-inner { grid-template-columns: 1fr 1fr; }
    .footer-bottom { flex-direction: column; text-align: center; }
  }

  @media(max-width:480px) {
    .hero-card img { height: 190px; }
    .overlay h2 { font-size: 1rem; }
    .headlines-grid { grid-template-columns: 1fr; }
    .footer-inner { grid-template-columns: 1fr; }
    .banner-row { flex-direction: column; }
  }
  </style>
</head>
<body>

<%- include('partials/header', { currentPage: currentPage }) %>

<%
const safeArray = (v) => Array.isArray(v) ? v : [];
const safePosts         = safeArray(posts);
const safeBreakingNews  = safeArray(breakingNews);
const safeFeaturedGrid  = safeArray(featuredGrid);
const safeRecentPosts   = safeArray(recentPosts);
const safeTrendingPosts = safeArray(trendingPosts);
const safeRandomPost    = typeof randomPost   !== "undefined" ? randomPost   : null;
const safeFeaturedPost  = typeof featuredPost !== "undefined" ? featuredPost : null;
const LOGO = '/voxaria-logo.png';

function timeAgo(date) {
  const diff = Math.floor((Date.now() - new Date(date)) / 1000);
  if (diff < 60) return diff + 's ago';
  if (diff < 3600) return Math.floor(diff/60) + 'm ago';
  if (diff < 86400) return Math.floor(diff/3600) + 'h ago';
  return Math.floor(diff/86400) + 'd ago';
}

const now = new Date();
const isRecent = (date) => (Date.now() - new Date(date)) < 2 * 60 * 60 * 1000;

const dateStr = now.toLocaleDateString('en-NG', {
  weekday:'long', year:'numeric', month:'long', day:'numeric'
});

const todayPosts = safePosts.filter(p => {
  const d = new Date(p.createdAt);
  return d.toDateString() === now.toDateString();
}).slice(0, 8);
%>

<!-- DATE BAR -->
<div class="date-bar">
  <span>📅 <%= dateStr %></span>
  <div style="display:flex;gap:16px;align-items:center;">
    <span class="live-badge"><span class="live-dot"></span>Live</span>
    <a href="/admin">Admin ›</a>
  </div>
</div>

<!-- BREAKING NEWS TICKER -->
<% if (safeBreakingNews.length > 0) { %>
<div class="breaking-news">
  <span class="breaking-label">🔴 Breaking</span>
  <div class="ticker-wrapper">
    <div class="ticker-track">
      <% safeBreakingNews.forEach(bn => { %>
        <a href="/news/<%= bn.slug || bn._id %>"><%= bn.title %></a>
      <% }) %>
    </div>
  </div>
</div>
<% } %>

<!-- DAILY KEY HEADLINES -->
<% if (todayPosts.length > 0) { %>
<section class="headlines-section">
  <div class="headlines-inner">
    <div class="headlines-header">
      <span class="live-badge"><span class="live-dot"></span>Live</span>
      <h2 class="headlines-title">Today's Key Headlines</h2>
      <span class="headlines-date"><%= dateStr %></span>
    </div>
    <div class="headlines-grid">
      <% todayPosts.forEach((post, i) => { %>
      <div class="headline-item">
        <span class="headline-num">0<%= i+1 %></span>
        <div class="headline-text">
          <span class="headline-cat"><%= post.category || 'News' %></span>
          <a href="/news/<%= post.slug %>"><%= post.title %></a>
        </div>
      </div>
      <% }) %>
    </div>
  </div>
</section>
<% } %>

<!-- HERO SECTION -->
<div class="hero-featured">

  <% if (safeFeaturedPost) { %>
  <div class="hero-card">
    <a href="/news/<%= safeFeaturedPost.slug || safeFeaturedPost._id %>">
      <img
        src="<%= safeFeaturedPost.mainImage || LOGO %>"
        alt="<%= safeFeaturedPost.title %>"
        onerror="this.onerror=null;this.src='<%= LOGO %>'">
      <div class="overlay">
        <% if(isRecent(safeFeaturedPost.createdAt)){ %>
          <span class="live-badge" style="margin-bottom:8px;display:inline-flex;"><span class="live-dot"></span>Live</span>
        <% } %>
        <% if(safeFeaturedPost.category){ %>
          <span class="overlay-cat"><%= safeFeaturedPost.category %></span>
        <% } %>
        <h2><%= safeFeaturedPost.title %></h2>
        <div class="overlay-meta">
          <%= safeFeaturedPost.author || 'VOXARIA' %> · <%= timeAgo(safeFeaturedPost.createdAt) %>
        </div>
      </div>
    </a>
  </div>
  <% } %>

